package main

import (
	"sgo"
	"std/math"
	"std/strconv"
)

func main(root *sgo.Context) error {
	out := strconv.Itoa(math.IntAbs(-7)) + " " + strconv.Itoa(math.IntPow(-2, 63)) + " " + strconv.Itoa(math.IntMin(3, math.IntMax(1, 2))) + " " + strconv.Itoa(math.MaxInt) + "\n"
	return root.Stdout().WriteString(out)
}
