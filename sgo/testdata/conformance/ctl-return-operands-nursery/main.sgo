package main

import "sgo"

func digit(i int) string {
	switch i {
	case 0:
		return "0"
	case 1:
		return "1"
	case 2:
		return "2"
	case 3:
		return "3"
	case 4:
		return "4"
	case 5:
		return "5"
	case 6:
		return "6"
	case 7:
		return "7"
	}
	return "?"
}

func mark(out *sgo.Writer, s string, v int) int {
	_ = out.WriteString(s + "\n")
	return v
}

func pair(out *sgo.Writer) (a int, b int) {
	defer func() { _ = out.WriteString("deferred in pair\n") }()
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error { return nil })
		return mark(out, "op1", 1), mark(out, "op2", 2)
	}
}

func failing(out *sgo.Writer) (a int, b int) {
	defer func() { _ = out.WriteString("deferred in failing\n") }()
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error { return sgo.NewError("child failed") })
		return mark(out, "op3", 3), mark(out, "op4", 4)
	}
}

func main(root *sgo.Context) error {
	out := root.Stdout()
	a, b := pair(out)
	if err := out.WriteString("pair " + digit(a) + " " + digit(b) + "\n"); err != nil {
		return err
	}
	c, d := failing(out)
	return out.WriteString("not reached " + digit(c) + digit(d) + "\n")
}
