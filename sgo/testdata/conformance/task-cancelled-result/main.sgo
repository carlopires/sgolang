package main

import "sgo"

// Waiting on a task inside a nursery its owner has cancelled is a cancellation point: the owner
// unwinds with the cancellation instead of waiting forever (D161, SGO-NATIVE). The task runs in
// the outer nursery and is not cancelled, so its result cannot be ready and the Wait must block;
// the unwinding error exit then cancels the outer nursery too (D159), which ends the task.
func main(root *sgo.Context) error {
	never := make(chan int)
	nursery (outer) {
		h := sgo.Go(outer, func(t *sgo.Context) (int, error) {
			<-never
			return 1, nil
		})
		nursery (inner) {
			inner.Cancel()
			_, err := h.Wait(root)
			if !sgo.IsCancelled(err) {
				return sgo.NewError("expected a cancellation error")
			}
		}
	}
	return root.Stdout().WriteString("unreachable\n")
}
