package main

import "sgo"

type Batch struct {
	Name  string
	Items []int
	Index map[string]int
}

func main(root *sgo.Context) error {
	ch := make(chan Batch, 1)
	b := Batch{Name: "b", Items: []int{1, 2}, Index: map[string]int{"x": 1}}
	nursery (n) {
		n.Spawn(func(t *sgo.Context) error {
			r := <-ch
			r.Items[0] = 100 // the receiver owns its copy
			r.Index["x"] = 100
			return nil
		})
		ch <- sgo.Copy(b)
	}
	ok := b.Items[0] == 1 && b.Index["x"] == 1
	if ok {
		return root.Stdout().WriteString("ok\n")
	}
	return root.Stdout().WriteString("wrong\n")
}
