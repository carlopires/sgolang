package main

import "sgo"

// Effect handles are shareable authority tokens with no revocation (D169): LendTo, the revocable
// copy of SGO-AUTH-003 v1, is withdrawn and refused. Authority is bounded by grants, ceilings
// (SpawnWithout), and attenuation (ReadOnly, Prefix).
func main(root *sgo.Context) error {
	s := root.SimStore()
	nursery (n) {
		lent := s.LendTo(n)
		n.Spawn(func(task *sgo.Context) error {
			return lent.Put("k", "from child")
		})
	}
	return nil
}
