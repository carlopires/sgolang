package main

import "sgo"

// A task in a nursery nested inside a child uses a file of the root's body (SGO-RES-002).
func main(root *sgo.Context) error {
	d := root.Dir("data")
	f := check d.Open(root, "a.txt")
	got := make(chan string, 1)
	nursery (n) {
		n.Spawn(func(t *sgo.Context) error {
			nursery (m) {
				m.Spawn(func(u *sgo.Context) error {
					s := check f.Read(16)
					got <- s
					return nil
				})
			}
			return nil
		})
	}
	return root.Stdout().WriteString("grandchild read " + <-got + "\n")
}
