package main

import "sgo"

// H04: two aliases of one permit share its terminal state; the second commit is a contract
// violation with no second effect.
func main(root *sgo.Context) error {
	out := root.Stdout()
	ch := sgo.NewChannel[string](2)
	p, err := ch.Reserve(root)
	if err != nil {
		return err
	}
	alias := p
	if ferr := p.Commit("once"); ferr != nil {
		return ferr
	}
	if werr := out.WriteString("first commit\n"); werr != nil {
		return werr
	}
	return alias.Commit("twice")
}
