package main

import "sgo"

type Tx struct {
	done bool
	log  string
}

func (t *Tx) Release(ok bool) error {
	t.done = true
	t.log += "released;"
	return nil
}

type holder struct {
	tx *Tx
}

func (h *holder) self() *holder {
	return h
}

// A store through a method call's result (W21 review Z1).
func main(root *sgo.Context) error {
	p := &holder{}
	nursery (n) {
		tx := &Tx{}
		n.Own(tx)
		p.self().tx = tx
	}
	_ = p
	return nil
}
