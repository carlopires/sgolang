package main

import "sgo"

// A task's result is latched when it ends (W22 review G2): a polling select over h.Result()
// ticks until the child ends, then the result arm proceeds on every later iteration without
// consuming the value, and a sibling's Wait (parked before the end) gets the same result.
func main(root *sgo.Context) error {
	ticks, seen := 0, 0
	sib := 0
	nursery (n) {
		h := sgo.Go(n, func(t *sgo.Context) (int, error) {
			check t.Sleep(35)
			return 7, nil
		})
		w := sgo.Go(n, func(t *sgo.Context) (int, error) { return h.Wait(t) })
	poll:
		for {
			select {
			case r := <-h.Result():
				if r.Err != nil || r.Value != 7 {
					return sgo.NewError("wrong result")
				}
				seen++
				if seen == 3 {
					break poll
				}
			case <-root.After(10):
				ticks++
			}
		}
		sib = check w.Wait(root)
	}
	return root.Stdout().WriteString("ticks " + itoa(ticks) + ", result seen " + itoa(seen) + " times, sibling " + itoa(sib) + "\n")
}

func itoa(v int) string {
	if v < 10 {
		return string(rune('0' + v))
	}
	return itoa(v/10) + string(rune('0'+v%10))
}
