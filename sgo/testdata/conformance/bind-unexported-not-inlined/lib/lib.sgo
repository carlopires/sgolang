package lib

// count is reachable only from Count, which is recursive and so never inlined: neither body is in
// the export data, and the export data does not carry count.
func count(n int) int {
	if n == 0 {
		return 0
	}
	return 1 + count(n-1)
}

func Count(n int) int {
	if n < 0 {
		return Count(-n)
	}
	return count(n)
}
