package main

import "sgo"

func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error {
			for {
				if err := task.Sleep(1); err != nil {
					if sgo.IsCancelled(err) {
						_ = out.WriteString("child saw cancel\n")
					}
					return err
				}
			}
		})
		n.Cancel()
	}
	return out.WriteString("after\n")
}
