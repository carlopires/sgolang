package main

import "sgo"

type inner struct {
	tm *sgo.Timer
}

type outer struct {
	name string
	in   inner
	pair [2]*sgo.Timer
}

type twice struct {
	a *sgo.Timer
	b *sgo.Timer
}

// fire re-arms tm from the reader's task and waits for it: usable only if tm is a resource of a
// scope the reader runs inside.
func fire(tm *sgo.Timer) bool {
	tm.Reset(1)
	v := <-tm.C()
	return v == 1
}

// A successful value-returning child's struct or array result moves every resource of the child's
// body that it holds into the nursery (SGO17-02, D158), so the nursery's tasks can use them: nested
// fields, array elements, the same timer held twice, a timer already acquired into
// the nursery, and a group's results. (A handle-typed field cannot be nil: SGO-TYPE-005.)
func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (n) {
		h := sgo.Go(n, func(t *sgo.Context) (outer, error) {
			return outer{
				name: "o",
				in:   inner{tm: t.NewTimer(1000)},
				pair: [2]*sgo.Timer{t.NewTimer(1000), t.NewTimer(1000)},
			}, nil
		})
		o := check h.Wait(root)
		if fire(o.in.tm) && fire(o.pair[0]) && fire(o.pair[1]) {
			check out.WriteString("nested struct and array: usable\n")
		}
		d := sgo.Go(n, func(t *sgo.Context) (twice, error) {
			tm := t.NewTimer(1000)
			return twice{a: tm, b: tm}, nil
		})
		w := check d.Wait(root)
		if fire(w.a) && fire(w.b) {
			check out.WriteString("repeated reference: usable\n")
		}
		k := sgo.Go(n, func(t *sgo.Context) (inner, error) {
			return inner{tm: n.NewTimer(1000)}, nil // already a resource of n
		})
		a := check k.Wait(root)
		if fire(a.tm) {
			check out.WriteString("already in the nursery: usable\n")
		}
		g := sgo.NewGroup[inner](n, 2)
		for i := 0; i < 3; i++ {
			g.Go(root, func(t *sgo.Context) (inner, error) {
				return inner{tm: t.NewTimer(1000)}, nil
			})
		}
		ok := 0
		for i := 0; i < 3; i++ {
			r := <-g.Next()
			if r.Err == nil && fire(r.Value.tm) {
				ok++
			}
		}
		if ok == 3 {
			check out.WriteString("group results: usable\n")
		}
	}
	return out.WriteString("nursery ended\n")
}
