package main

import "sgo"

// A slot takes only a connection whose scope it encloses (D157): a slot of a nursery cannot take a
// connection of the root's body, which outlives the nursery.
func main(root *sgo.Context) error {
	_ = check root.Listen("127.0.0.1:47958")
	c := check root.Dial("127.0.0.1:47958")
	nursery (n) {
		slot := n.NewConnSlot()
		check slot.Put(c)
	}
	return nil
}
