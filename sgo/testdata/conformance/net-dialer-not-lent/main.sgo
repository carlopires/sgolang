package main

import "sgo"

// A child uses a dialer only through a nursery it is lent to.
func main(root *sgo.Context) error {
	d := root.Dialer([]string{"127.0.0.1:47954"})
	nursery (n) {
		n.Spawn(func(t *sgo.Context) error {
			_, err := d.Dial(t, "127.0.0.1:47954")
			return err
		})
	}
	return d.Close()
}
