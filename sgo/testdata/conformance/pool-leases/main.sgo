package main

import "sgo"

type conn struct {
	id int
}

// Three workers share two items: each holds one lease at a time, and every item comes back when
// the lease's scope ends (D175).
func main(root *sgo.Context) error {
	out := root.Stdout()
	done := make(chan int, 16)
	nursery (n) {
		p := sgo.NewPool[conn](n)
		p.Put(conn{id: 1})
		p.Put(conn{id: 2})
		for w := 0; w < 3; w++ {
			n.Spawn(func(t *sgo.Context) error {
				for i := 0; i < 4; i++ {
					nursery (use) {
						l := p.Acquire(use)
						c := l.Value()
						check t.Sleep(1)
						done <- c.id
					}
				}
				return nil
			})
		}
	}
	got := 0
	for i := 0; i < 12; i++ {
		v := <-done
		if v == 1 || v == 2 {
			got++
		}
	}
	check out.WriteString("leases: " + itoa(got) + "\n")
	nursery (m) {
		p := sgo.NewPool[conn](m)
		p.Put(conn{id: 7})
		nursery (a) {
			l := p.Acquire(a)
			l.Return() // back early: the scope end does not return it again
		}
		nursery (b) {
			l := p.Acquire(b)
			l.Drop() // gone for good
		}
		nursery (c) {
			back := make(chan int, 1)
			c.Spawn(func(t *sgo.Context) error {
				nursery (u) {
					l := p.Acquire(u) // waits: the only item was dropped
					back <- l.Value().id
				}
				return nil
			})
			select {
			case <-back:
				check out.WriteString("BAD: a dropped item came back\n")
			case <-root.After(20):
				check out.WriteString("dropped item gone; waiter cancelled\n")
			}
			c.Cancel()
		}
	}
	return nil
}

func itoa(v int) string {
	if v == 0 {
		return "0"
	}
	s := ""
	for v > 0 {
		s = string(rune('0'+v%10)) + s
		v /= 10
	}
	return s
}
