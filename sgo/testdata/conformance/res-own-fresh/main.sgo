package main

import "sgo"

type Tx struct {
	done bool
	log  string
}

func (t *Tx) Release(ok bool) error {
	t.done = true
	t.log += "released;"
	return nil
}

type holder struct {
	tx *Tx
}

// Own of a value made in the call, or a local made inside the scope, is legal (Z2).
func main(root *sgo.Context) error {
	nursery (n) {
		n.Own(&Tx{})
		tx := &Tx{}
		n.Own(tx)
	}
	return root.Stdout().WriteString("owned\n")
}
