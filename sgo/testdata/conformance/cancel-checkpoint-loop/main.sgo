package main

import "sgo"

func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error {
			for {
				if err := task.Checkpoint(); err != nil {
					return err
				}
			}
		})
		if err := root.Sleep(5); err != nil {
			return err
		}
		n.Cancel()
	}
	return out.WriteString("after\n")
}
