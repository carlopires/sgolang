package main

import (
	"sgo"
	"std/strconv"
)

func show(out *sgo.Writer, name string, f float64) error {
	return out.WriteString(name + " " + strconv.FormatFloat(f, 'g', -1) + " " + strconv.FormatFloat(f, 'x', -1) + "\n")
}

func main(root *sgo.Context) error {
	out := root.Stdout()
	a, b := 0.1, 0.2
	check show(out, "sum", a+b)
	check show(out, "diff", a-b)
	check show(out, "prod", a*b)
	check show(out, "quot", a/b)
	check show(out, "neg", -a)
	// x*y rounds to 1 before the add: the result is 0 on every target. A fused multiply-add
	// would give -2^-60.
	x := 1 + 0x1p-30
	y := 1 - 0x1p-30
	m := -1.0
	check show(out, "muladd", m+x*y)
	z := 1.5
	z += 2
	z *= 3
	z -= 0.25
	z /= 2
	z++
	z--
	check show(out, "assign", z)
	return show(out, "third", 1.0/3)
}
