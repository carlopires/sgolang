package main

import "sgo"

type Table struct {
	W    map[string]int
	Rows []Row
	N    int
}

type Row struct {
	Name string
	V    int
}

func (r Row) Twice() int {
	return 2 * r.V
}

func (r *Row) Bump() {
	r.V++
}

func build() Table {
	return Table{W: map[string]int{"a": 1, "b": 2}, Rows: []Row{{"x", 3}, {"y", 4}}, N: 5}
}

type Outer struct {
	In  sgo.Frozen[Table]
	Tag string
}

func main(c *sgo.Context) error {
	o := sgo.Freeze(Outer{In: sgo.Freeze(build()), Tag: "t"})
	in := o.Get().In
	ok := in.Get().N == 5 && o.Get().Tag == "t" && o.Get().In.Get().W["a"] == 1
	if ok {
		return c.Stdout().WriteString("ok\n")
	}
	return c.Stdout().WriteString("wrong\n")
}
