package main

import "sgo"

func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error {
			defer func() { _ = out.WriteString("sibling cleanup ran\n") }()
			for {
				if err := task.Sleep(1); err != nil {
					_ = out.WriteString("sibling saw: " + err.Error() + "\n")
					return err
				}
			}
		})
		n.Spawn(func(task *sgo.Context) error { panic("p1") })
	}
	return nil
}
