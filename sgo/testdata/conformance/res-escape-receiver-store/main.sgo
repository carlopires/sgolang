package main

import "sgo"

type Tx struct {
	done bool
	log  string
}

func (t *Tx) Release(ok bool) error {
	t.done = true
	t.log += "released;"
	return nil
}

type holder struct {
	tx *Tx
}

// Storing a parameter's resource into the receiver's memory is an escape (Z1).
func (h *holder) set(t *Tx) {
	h.tx = t
}

func main(root *sgo.Context) error {
	p := &holder{}
	nursery (n) {
		tx := &Tx{}
		n.Own(tx)
		p.set(tx)
	}
	return nil
}
