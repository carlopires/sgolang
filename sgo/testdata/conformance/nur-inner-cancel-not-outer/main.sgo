package main

import "sgo"

func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (a) {
		a.Spawn(func(task *sgo.Context) error { return nil })
		nursery (b) {
			b.Spawn(func(task *sgo.Context) error {
			for {
				if err := task.Sleep(1); err != nil {
					return err
				}
			}
		})
			b.Cancel()
		}
		if err := root.Checkpoint(); err != nil {
			return out.WriteString("bad: outer cancelled\n")
		}
		_ = out.WriteString("outer ok\n")
	}
	return nil
}
