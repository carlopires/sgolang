package main

import "sgo"

type Tx struct {
	done bool
	log  string
}

func (t *Tx) Release(ok bool) error {
	t.done = true
	t.log += "released;"
	return nil
}

type holder struct {
	tx *Tx
}

// A resource never becomes an interface value: an interface is not tied to a scope (Z1).
func main(root *sgo.Context) error {
	var a any = 0
	nursery (n) {
		tx := &Tx{}
		n.Own(tx)
		a = tx
	}
	_ = a
	return nil
}
