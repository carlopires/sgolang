package main

import "sgo"

func main(root *sgo.Context) error {
	out := root.Stdout()
	c := make(chan bool)
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error {
			c <- true
			c <- false
			c <- true
			close(c)
			return nil
		})
		count := 0
		for b := range c {
			if b {
				count++
			}
		}
		if count == 2 {
			if err := out.WriteString("two true\n"); err != nil {
				return err
			}
		}
	}
	return nil
}
