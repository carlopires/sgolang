package main

import (
	"sgo"
	"std/crypto/rsa"
	"std/crypto/sha256"
	"std/encoding/hex"
)

func main(root *sgo.Context) error {
	n, _ := hex.DecodeString("")
	sig, _ := hex.DecodeString("")
	pub := &rsa.PublicKey{N: n, E: 65537}
	h := sha256.Sum256([]byte{})
	out := ""
	if err := rsa.VerifyPKCS1v15(pub, rsa.SHA256, h[:], sig); err == nil {
		out = out + "valid\n"
	}
	other := sha256.Sum256([]byte("other"))
	if err := rsa.VerifyPKCS1v15(pub, rsa.SHA256, other[:], sig); err != nil {
		out = out + err.Error() + "\n"
	}
	small := &rsa.PublicKey{N: []byte{0xc3}, E: 65537}
	if err := rsa.VerifyPSS(small, rsa.SHA256, h[:], sig, rsa.PSSSaltLengthAuto); err != nil {
		out = out + err.Error() + "\n"
	}
	return root.Stdout().WriteString(out)
}
