package main

import "sgo"

func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error { return sgo.NewError("child failed") })
		if err := root.Sleep(60000); err != nil {
			_ = out.WriteString("owner woken\n")
			return err
		}
	}
	return nil
}
