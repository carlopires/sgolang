package main

import "sgo"

func main(root *sgo.Context) error {
	a := []int{1, 2, 3, 4}
	b := a[1:2:2]
	b = append(b, 99) // capacity 1: a new array, a is untouched
	ok := len(b) == 2 && cap(a[1:3]) == 3 && a[2] == 3 && a[:2][1] == 2 && len(a[2:]) == 2
	if ok {
		return root.Stdout().WriteString("ok\n")
	}
	return root.Stdout().WriteString("wrong\n")
}
