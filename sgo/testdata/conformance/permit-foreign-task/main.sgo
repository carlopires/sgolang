package main

import "sgo"

// H05: a permit is task-affine; another task's commit is rejected and ownership does not move.
func main(root *sgo.Context) error {
	ch := sgo.NewChannel[string](1)
	p, err := ch.Reserve(root)
	if err != nil {
		return err
	}
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error {
			return p.Commit("stolen")
		})
	}
	return nil
}
