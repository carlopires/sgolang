package main

import "sgo"

type Shape interface {
	Area() int
}

type Rect struct {
	w int
	h int
}

func (r Rect) Area() int { return r.w * r.h }

func kind(s Shape) string {
	switch s.(type) {
	case nil:
		return "nil"
	case Rect:
		return "rect"
	}
	return "none"
}

func main(root *sgo.Context) error {
	var r *Rect = nil
	_ = r
	return root.Stdout().WriteString(kind(nil) + " " + kind(Rect{w: 1, h: 1}) + "\n")
}
