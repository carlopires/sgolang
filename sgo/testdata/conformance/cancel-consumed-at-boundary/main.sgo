package main

import "sgo"

func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error {
			for {
				if err := task.Sleep(1); err != nil {
					return err
				}
			}
		})
		n.Cancel()
		if err := root.Checkpoint(); err != nil {
			_ = out.WriteString("inside: cancelled\n")
		}
	}
	if err := root.Checkpoint(); err != nil {
		return out.WriteString("bad: still cancelled\n")
	}
	return out.WriteString("after: not cancelled\n")
}
