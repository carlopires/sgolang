package main

import "sgo"

type holder struct {
	c *sgo.Conn
}

// A struct holding a connection is sent on a channel.
func main(root *sgo.Context) error {
	if _, err := root.Listen("127.0.0.1:47922"); err != nil {
		return err
	}
	c, derr := root.Dial("127.0.0.1:47922")
	if derr != nil {
		return derr
	}
	ch := make(chan holder, 1)
	ch <- holder{c: c}
	return nil
}
