package main

import "sgo"

func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error {
			for {
				if err := task.Sleep(1); err != nil {
					return err
				}
			}
		})
		_ = out.WriteString("cancelling\n")
		n.Cancel()
	}
	return out.WriteString("after\n")
}
