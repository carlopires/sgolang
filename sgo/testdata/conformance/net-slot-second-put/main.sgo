package main

import "sgo"

// Only the first Put succeeds; the second connection stays its owner's.
func main(root *sgo.Context) error {
	l, err := root.Listen("127.0.0.1:47955")
	if err != nil {
		return err
	}
	a, aerr := root.Dial("127.0.0.1:47955")
	if aerr != nil {
		return aerr
	}
	b, berr := root.Dial("127.0.0.1:47955")
	if berr != nil {
		return berr
	}
	slot := root.NewConnSlot()
	first := slot.Put(a) == nil
	second := slot.Put(b) == nil
	_, werr := b.Write("still mine")
	c, ok := slot.Take()
	line := "first=" + yes(first) + " second=" + yes(second) + " b-usable=" + yes(werr == nil) + " took=" + yes(ok)
	if e := root.Stdout().WriteString(line + "\n"); e != nil {
		return e
	}
	for _, e := range []error{c.Close(), b.Close(), slot.Close(), l.Close()} {
		if e != nil {
			return e
		}
	}
	return nil
}

func yes(b bool) string {
	if b {
		return "yes"
	}
	return "no"
}
