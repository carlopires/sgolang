package main

import (
	"sgo"
	"std/crypto/x509"
	"std/encoding/hex"
)

const peerHex = ""
const rootHex = ""
const intHex = ""

func show(err error) string {
	if err == nil {
		return "ok"
	}
	return err.Error()
}

func cert(h string) *x509.Certificate {
	d, _ := hex.DecodeString(h)
	c, _ := x509.ParseCertificate(d)
	return c
}

// main verifies an x509-limbo chain (rfc5280::nc::permitted-dns-match) as Go does (SGO-STD-029).
func main(root *sgo.Context) error {
	peer := cert(peerHex)
	roots := x509.NewCertPool()
	roots.AddCert(cert(rootHex))
	ints := x509.NewCertPool()
	if intHex != "" {
		ints.AddCert(cert(intHex))
	}
	out := ""
	_, err := peer.Verify(x509.VerifyOptions{DNSName: "example.com", Intermediates: ints, Roots: roots, CurrentTime: 1793996054, KeyUsages: []x509.ExtKeyUsage{}, CertificatePolicies: []x509.OID{}})
	out += show(err) + "\n"
	_, err = peer.Verify(x509.VerifyOptions{DNSName: "other.test", Intermediates: ints, Roots: roots, CurrentTime: 1793996054, KeyUsages: []x509.ExtKeyUsage{}, CertificatePolicies: []x509.OID{}})
	out += show(err) + "\n"
	_, err = peer.Verify(x509.VerifyOptions{DNSName: "example.com", Intermediates: ints, Roots: roots, CurrentTime: 32503680000, KeyUsages: []x509.ExtKeyUsage{}, CertificatePolicies: []x509.OID{}})
	out += show(err) + "\n"
	_, err = x509.ParseCertificate([]byte{0x30, 0x03, 0x02, 0x01, 0x01})
	out += show(err) + "\n"
	return root.Stdout().WriteString(out)
}
