package main

import "sgo"

// Virtual time advances only when no task is ready (D07): the sleeper wakes after the busy task.
func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error {
			x := 0
			for i := 0; i < 20000; i++ {
				x = x + i
			}
			if x < 0 {
				return sgo.NewError("unreachable")
			}
			return out.WriteString("busy\n")
		})
		n.Spawn(func(task *sgo.Context) error {
			if err := task.Sleep(1); err != nil {
				return err
			}
			return out.WriteString("late\n")
		})
	}
	return nil
}
