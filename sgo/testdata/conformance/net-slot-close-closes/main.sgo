package main

import "sgo"

// A connection left in a slot is closed with it: the peer reads end of stream.
func main(root *sgo.Context) error {
	l, err := root.Listen("127.0.0.1:47956")
	if err != nil {
		return err
	}
	slot := root.NewConnSlot()
	c, derr := root.Dial("127.0.0.1:47956")
	if derr != nil {
		return derr
	}
	if e := slot.Put(c); e != nil {
		return e
	}
	s, aerr := l.Accept()
	if aerr != nil {
		return aerr
	}
	if e := slot.Close(); e != nil {
		return e
	}
	_, rerr := s.Read(16)
	if e := root.Stdout().WriteString("peer eof=" + eof(rerr) + "\n"); e != nil {
		return e
	}
	for _, e := range []error{s.Close(), l.Close()} {
		if e != nil {
			return e
		}
	}
	return nil
}

func eof(err error) string {
	if sgo.IsEOF(err) {
		return "yes"
	}
	return "no"
}
