package main

import "sgo"

func digit(i int) string {
	switch i {
	case 0:
		return "0"
	case 1:
		return "1"
	case 2:
		return "2"
	case 3:
		return "3"
	case 4:
		return "4"
	case 5:
		return "5"
	case 6:
		return "6"
	case 7:
		return "7"
	}
	return "?"
}

func helper(outer *sgo.Nursery, out *sgo.Writer, k int) {
	v := "value " + digit(k)
	outer.Spawn(func(task *sgo.Context) error {
		x := 0
		for i := 0; i < 5000000; i++ {
			x = (x + i) % 7
		}
		if x < 0 {
			return nil
		}
		return out.WriteString(v + "\n")
	})
}

func clobber(depth int, a int, b int, c int) int {
	s := (a + b + c + depth) % 1000
	if depth == 0 {
		return s - (a+b+c)%1000
	}
	return clobber(depth-1, s, s+1, s+2) - depth + depth
}

func main(root *sgo.Context) error {
	out := root.Stdout()
	nursery (n) {
		helper(n, out, 7)
		if clobber(500, 1, 2, 3) != 0 {
			return sgo.NewError("bad clobber")
		}
	}
	return out.WriteString("end\n")
}
