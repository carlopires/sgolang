package main

import "sgo"

// Two attempts race through a dialer, dialing into the race nursery n and reporting on a channel
// made in n. The body keeps the first connection, moves it to the root, and cancels the race; n
// releases the losing connection when it ends. Nothing is closed by hand (D158, SGO-RES-001).
type outcome struct {
	ok bool
	c  *sgo.Conn
}

func main(root *sgo.Context) error {
	l := check root.Listen("127.0.0.1:47950")
	d := root.Dialer([]string{"[::1]:47950", "127.0.0.1:47950"})
	won := outcome{}
	nursery (n) {
		results := sgo.NewChannel[outcome](2)
		for _, addr := range []string{"[::1]:47950", "127.0.0.1:47950"} {
			a := addr
			n.Spawn(func(t *sgo.Context) error {
				p := check results.Reserve(t)
				c, err := d.Dial(n, a)
				if err != nil {
					return p.Commit(outcome{}) // a failed attempt is not an error of the race
				}
				return p.Commit(outcome{ok: true, c: c})
			})
		}
		for i := 0; i < 2 && !won.ok; i++ {
			r, more, rerr := results.Receive(root)
			if rerr != nil {
				return rerr
			}
			if more && r.ok {
				c := r.c
				check c.MoveTo(root)
				won.ok, won.c = true, c
			}
		}
		n.Cancel()
	}
	if !won.ok {
		return sgo.NewError("no connection")
	}
	s := check l.Accept(root)
	check won.c.Write("ping")
	msg := check s.Read(16)
	check root.Stdout().WriteString("server got " + msg + "\n")
	return nil
}
