// p4-eval: a tree of expressions in one task (no interfaces: a tagged node).
package main

import "sgo"

const (
	Num = 0
	Var = 1
	Add = 2
	Mul = 3
)

type Expr struct {
	Op   int
	V    int
	Name string
	L, R *Expr
}

type Env struct {
	vars   map[string]int
	parent *Env
}

func (e *Env) Lookup(name string) (int, error) {
	for s := e; s != nil; s = s.parent {
		if v, ok := s.vars[name]; ok {
			return v, nil
		}
	}
	return 0, sgo.NewError("undefined: " + name)
}

func eval(x *Expr, env *Env) (int, error) {
	switch x.Op {
	case Num:
		return x.V, nil
	case Var:
		return env.Lookup(x.Name)
	}
	l, err := eval(x.L, env)
	if err != nil {
		return 0, err
	}
	r, err := eval(x.R, env)
	if err != nil {
		return 0, err
	}
	if x.Op == Add {
		return l + r, nil
	}
	return l * r, nil
}

func main(c *sgo.Context) error {
	global := &Env{vars: map[string]int{"x": 3}}
	local := &Env{vars: map[string]int{"y": 4}, parent: global}
	// (x + y) * 2
	e := &Expr{Op: Mul, L: &Expr{Op: Add, L: &Expr{Op: Var, Name: "x"}, R: &Expr{Op: Var, Name: "y"}}, R: &Expr{Op: Num, V: 2}}
	v, err := eval(e, local)
	if err != nil {
		return err
	}
	return c.Stdout().WriteString(itoa(v) + "\n")
}

// itoa formats a non-negative integer (stage 2: []byte, append, string conversion).
func itoa(v int) string {
	if v == 0 {
		return "0"
	}
	b := []byte{}
	for ; v > 0; v /= 10 {
		b = append([]byte{byte(48 + v%10)}, b...)
	}
	return string(b)
}
