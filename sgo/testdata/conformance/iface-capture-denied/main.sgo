package main

import "sgo"

type Shape interface {
	Area() int
}

type Rect struct {
	w int
	h int
}

func (r Rect) Area() int { return r.w * r.h }

func main(root *sgo.Context) error {
	var s Shape = Rect{w: 1, h: 1}
	nursery (n) {
		n.Spawn(func(t *sgo.Context) error {
			_ = s.Area()
			return nil
		})
	}
	return nil
}
