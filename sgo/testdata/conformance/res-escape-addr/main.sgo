package main

import "sgo"

type Tx struct {
	done bool
	log  string
}

func (t *Tx) Release(ok bool) error {
	t.done = true
	t.log += "released;"
	return nil
}

type holder struct {
	tx *Tx
}

// The address of a local holding a resource is itself tied to that local's scope (Z1).
func main(root *sgo.Context) error {
	pp := &holder{}
	nursery (n) {
		tx := &Tx{}
		n.Own(tx)
		h := holder{tx: tx}
		pp = &h
	}
	_ = pp
	return nil
}
