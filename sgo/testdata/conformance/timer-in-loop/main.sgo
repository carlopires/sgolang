package main

import "sgo"

// Each execution of the select makes a new timer; a loop of timed selects ends (SGO-WAIT-003).
func main(root *sgo.Context) error {
	never := make(chan int)
	timeouts := 0
	for i := 0; i < 5; i++ {
		select {
		case <-never:
		case <-root.After(2):
			timeouts++
		}
	}
	if timeouts != 5 {
		return sgo.NewError("missed a timeout")
	}
	return root.Stdout().WriteString("five timeouts\n")
}
