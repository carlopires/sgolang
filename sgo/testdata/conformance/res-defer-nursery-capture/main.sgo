package main

import "sgo"

type Tx struct {
	done bool
	log  string
}

func (t *Tx) Release(ok bool) error {
	t.done = true
	t.log += "released;"
	return nil
}

type holder struct {
	tx *Tx
}

// A deferred call runs when the function returns, after the nursery released the resource (Z3).
func main(root *sgo.Context) error {
	nursery (n) {
		tx := &Tx{}
		n.Own(tx)
		defer func() {
			tx.log += "deferred;"
		}()
	}
	return nil
}
