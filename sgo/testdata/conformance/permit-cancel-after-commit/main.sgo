package main

import "sgo"

// H07: cancellation after the commit linearized is not retroactive: the send stays successful and
// the value is received exactly once.
func main(root *sgo.Context) error {
	out := root.Stdout()
	ch := sgo.NewChannel[string](1)
	nursery (n) {
		n.Spawn(func(task *sgo.Context) error {
			p, err := ch.Reserve(task)
			if err != nil {
				return err
			}
			if ferr := p.Commit("sent"); ferr != nil {
				return ferr
			}
			_ = out.WriteString("commit ok\n")
			return task.Sleep(60000)
		})
		v, ok, err := ch.Receive(root)
		if err != nil || !ok {
			return sgo.NewError("receive failed")
		}
		n.Cancel()
		if werr := out.WriteString(v + "\n"); werr != nil {
			return werr
		}
	}
	ch.Close()
	_, ok, err := ch.Receive(root)
	if err != nil || ok {
		return sgo.NewError("value received twice")
	}
	return out.WriteString("once\n")
}
