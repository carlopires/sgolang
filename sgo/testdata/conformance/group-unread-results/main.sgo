package main

import "sgo"

// Results are queued without bound: children never wait to publish, so a nursery whose owner reads
// no result still joins (D172, SGO-SPAWN-007).
func main(root *sgo.Context) error {
	nursery (n) {
		g := sgo.NewGroup[int](n, 0)
		for i := 0; i < 50; i++ {
			g.Go(root, func(t *sgo.Context) (int, error) { return 1, nil })
		}
	}
	return root.Stdout().WriteString("joined\n")
}
