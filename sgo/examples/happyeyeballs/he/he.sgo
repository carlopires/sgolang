// Package he is Happy Eyeballs version 2 (RFC 8305) in S-Go: connect to a host name over IPv6
// and IPv4 at once, preferring IPv6, without waiting for a dead address family.
//
// One nursery holds the whole race. The two queries are tasks with results (sgo.Go), the attempts
// are a group (sgo.NewGroup), and the two RFC delays are timers of the race. The nursery body
// selects on all of them and decides everything. Each attempt dials into the race nursery, so the
// body moves the winner out to the caller and the nursery releases every loser when it ends. Nothing is closed by hand, and nothing outlives Connect.
package he

import "sgo"

// The RFC 8305 delays, in milliseconds.
const (
	ResolutionDelay = 50  // §3: after an A answer, how long to wait for the AAAA answer
	AttemptDelay    = 250 // §5: how long an attempt runs before the next one starts beside it
)

// Logger receives one line per step of the race; Connect's callers print or collect them.
type Logger interface {
	Log(line string) error
}

// Result is what Connect reached: the address, and the connection, a resource of the caller's
// scope (task's body).
type Result struct {
	Addr string
	Conn *sgo.Conn
}

// attempt is the result of one connection attempt; its connection is a resource of the race.
type attempt struct {
	addr string
	seq  int
	conn *sgo.Conn
}

// Connect connects to host through d, a dialer whose endpoints name host (grant connect
// HOST:PORT), and returns the connection and the address it reached. d is a resource of a scope
// enclosing the call; log may be nil. If no address accepts a connection, Connect returns an
// error.
func Connect(task *sgo.Context, d *sgo.Dialer, host string, log Logger) (Result, error) {
	res := Result{}
	var failure error = nil // an error that ends the race early (a failed log or move)
	nursery (n) {
		aaaa := sgo.Go(n, func(t *sgo.Context) (sgo.Frozen[[]string], error) { return lookup(d, host, "ip6") }).Result()
		a := sgo.Go(n, func(t *sgo.Context) (sgo.Frozen[[]string], error) { return lookup(d, host, "ip4") }).Result()
		attempts := sgo.NewGroup[attempt](n, 0)
		resolution, next := n.NewTimer(0), n.NewTimer(0) // §3 and §5 delays, armed when needed
		resolution.Stop()
		next.Stop()
		v6, v4 := []string{}, []string{} // addresses not yet attempted, in answer order
		done6, done4, waited := false, false, false
		started, inflight := 0, 0
		mayStart, lastV6 := true, false // §5: may start an attempt now; §4: last family tried
		latest := ""                    // the address of the latest attempt
	race:
		for failure == nil {
			// §3: start once the AAAA answer is in, or the A answer and the resolution delay.
			ready := done6 || (done4 && waited)
			if ready && mayStart && len(v6)+len(v4) > 0 {
				pick := ""
				if len(v6) > 0 && (!lastV6 || len(v4) == 0) { // §4: interleave, IPv6 first
					pick, v6, lastV6 = v6[0], v6[1:], true
				} else {
					pick, v4, lastV6 = v4[0], v4[1:], false
				}
				started, inflight, mayStart = started+1, inflight+1, false
				addr, seq := pick, started
				latest = pick
				next.Reset(AttemptDelay)
				if failure = say(log, "attempt "+addr); failure != nil {
					break race
				}
				// The attempt dials into the race nursery: the connection is a candidate the body
				// may keep, and the nursery releases it otherwise.
				attempts.Go(task, func(t *sgo.Context) (attempt, error) {
					c, err := d.Dial(n, addr)
					return attempt{addr: addr, seq: seq, conn: c}, err
				})
			}
			if ready && inflight == 0 && done6 && done4 && len(v6)+len(v4) == 0 {
				break race // every address failed
			}
			select {
			case r := <-aaaa:
				done6, v6 = true, appendAll(v6, r)
				failure = say(log, "AAAA answer in")
			case r := <-a:
				done4, v4 = true, appendAll(v4, r)
				if !done6 {
					resolution.Reset(ResolutionDelay)
				}
				failure = say(log, "A answer in")
			case <-resolution.C():
				waited = true
				if !done6 {
					failure = say(log, "resolution delay passed without an AAAA answer")
				}
			case <-next.C():
				// The latest attempt is still running after AttemptDelay: the next one may start
				// beside it, now or as soon as an address arrives.
				mayStart = true
				failure = say(log, "no answer from "+latest+" after "+itoa(AttemptDelay)+"ms")
			case r := <-attempts.Next():
				inflight--
				if r.Err != nil {
					if r.Value.seq == started {
						mayStart = true // the latest attempt failed: fall back at once
						next.Stop()
					}
					failure = say(log, "failed "+r.Value.addr)
					continue race
				}
				if failure = say(log, "connected "+r.Value.addr); failure == nil {
					// The winner leaves the race for the caller's scope; the race keeps the rest.
					c := r.Value.conn
					if failure = c.MoveTo(task); failure == nil {
						res = Result{Addr: r.Value.addr, Conn: c}
					}
				}
				break race
			}
		}
		n.Cancel() // the race is decided or abandoned: end every query, timer, and attempt
	} // the nursery joins its children, then releases every connection that lost
	if failure != nil {
		return Result{}, failure
	}
	if res.Addr == "" {
		return res, sgo.NewError("happy eyeballs: no address of " + host + " accepted a connection")
	}
	return res, nil
}

// lookup runs one query (§3). A failed query counts as an answer without addresses.
func lookup(d *sgo.Dialer, host, family string) (sgo.Frozen[[]string], error) {
	addrs, err := d.Resolve(host, family)
	if err != nil && sgo.IsCancelled(err) {
		return sgo.Freeze([]string{}), err
	}
	return sgo.Freeze(addrs), nil
}

func appendAll(dst []string, r sgo.Result[sgo.Frozen[[]string]]) []string {
	for _, s := range r.Value.Get() {
		dst = append(dst, s)
	}
	return dst
}

func say(log Logger, line string) error {
	if log == nil {
		return nil
	}
	return log.Log(line)
}

func itoa(v int) string {
	if v == 0 {
		return "0"
	}
	s := ""
	for v > 0 {
		s = string(rune('0'+v%10)) + s
		v = v / 10
	}
	return s
}
