// Package he is Happy Eyeballs version 2 (RFC 8305) in S-Go: connect to a host name over IPv6
// and IPv4 at once, preferring IPv6, without waiting for a dead address family.
//
// One nursery holds the whole race: the AAAA and A queries (§3), the resolution delay timer, the
// connection attempts and the timer that staggers them (§5). The nursery body is the only place
// that decides anything; every child just does one thing and reports it on one channel. When an
// attempt connects, it hands its connection to a slot (the first Put wins); the body cancels the
// nursery, which ends every other query, timer and attempt, and the nursery joins them all before
// Connect returns. So when Connect returns there is nothing left running, and every connection
// but the winner's is closed — not by convention, but because the language has no other way.
package he

import "sgo"

// The RFC 8305 delays, in milliseconds.
const (
	ResolutionDelay = 50  // §3: after an A answer, how long to wait for the AAAA answer
	AttemptDelay    = 250 // §5: how long an attempt runs before the next one starts beside it
)

// event kinds: what the children report to the nursery body.
const (
	evAddr      = 0 // an address of a family (addr, v6)
	evDone      = 1 // a family's query finished (v6)
	evWaited    = 2 // the resolution delay passed
	evConnected = 3 // attempt seq connected and won the slot (addr)
	evFailed    = 4 // attempt seq failed (addr)
	evTick      = 5 // attempt seq ran AttemptDelay ms
)

type event struct {
	kind int
	v6   bool
	addr string
	seq  int
}

// Logger receives one line per step of the race; Connect's callers print or collect them.
type Logger interface {
	Log(line string) error
}

// Connect connects to host through d, a dialer whose endpoints name host (grant connect
// HOST:PORT), puts the connection into slot, and returns the address it reached. task must own
// slot, and own d or run in a nursery d is lent to; log may be nil. The caller takes the
// connection with slot.Take: a capability is never nil in S-Go, so it travels in the slot rather
// than in a result. If no address accepts a connection, Connect returns an error and the slot
// stays empty.
func Connect(task *sgo.Context, d *sgo.Dialer, slot *sgo.ConnSlot, host string, log Logger) (string, error) {
	events := sgo.NewChannel[event](64)
	winner := ""
	nursery (n) {
		ld, ls := d, slot
		n.Spawn(func(t *sgo.Context) error { return resolve(t, ld, host, true, events) })
		n.Spawn(func(t *sgo.Context) error { return resolve(t, ld, host, false, events) })
		won, rerr := race(task, n, ld, ls, events, log)
		if rerr != nil {
			return "", rerr
		}
		winner = won
		n.Cancel() // the race is decided: end every query, timer, and attempt still running
	}
	if winner == "" {
		return "", sgo.NewError("happy eyeballs: no address of " + host + " accepted a connection")
	}
	return winner, nil
}

// race is the nursery body: it collects the addresses as they come, starts attempts in RFC 8305
// order and pace, and returns the address of the attempt that connected ("" if none did).
func race(task *sgo.Context, n *sgo.Nursery, d *sgo.Dialer, slot *sgo.ConnSlot, events *sgo.Channel[event], log Logger) (string, error) {
	v6, v4 := []string{}, []string{} // addresses not yet attempted, in answer order
	done6, done4, waited, waiting := false, false, false, false
	started, inflight := 0, 0 // attempts started; attempts still running
	mayStart := true          // §5: no attempt yet, the last one failed, or it ran AttemptDelay
	lastV6 := false // the family of the last attempt started (§4: alternate)
	for {
		// §3: start once the AAAA answer is in, or the A answer is in and the resolution delay
		// passed (or the AAAA query is over without addresses).
		ready := done6 || (done4 && waited)
		if !ready && done4 && !waiting {
			waiting = true
			n.Spawn(func(t *sgo.Context) error {
				if serr := t.Sleep(ResolutionDelay); serr != nil {
					return serr
				}
				return send(t, events, event{kind: evWaited})
			})
		}
		// §5: start the next attempt when allowed: first, after a failure, or after a tick.
		if ready && mayStart && len(v6)+len(v4) > 0 {
			next := ""
			// §4: interleave the families, IPv6 first.
			if len(v6) > 0 && (!lastV6 || len(v4) == 0) {
				next, v6, lastV6 = v6[0], v6[1:], true
			} else {
				next, v4, lastV6 = v4[0], v4[1:], false
			}
			started++
			inflight++
			mayStart = false
			if lerr := say(log, "attempt "+next); lerr != nil {
				return "", lerr
			}
			attempt(n, d, slot, events, next, started)
		}
		if ready && inflight == 0 && done6 && done4 && len(v6)+len(v4) == 0 {
			return "", nil // every address failed
		}
		ev, ok, err := events.Receive(task)
		if err != nil {
			return "", err
		}
		if !ok {
			return "", nil
		}
		switch ev.kind {
		case evAddr:
			if ev.v6 {
				v6 = append(v6, ev.addr)
			} else {
				v4 = append(v4, ev.addr)
			}
		case evDone:
			if ev.v6 {
				done6 = true
			} else {
				done4 = true
			}
			if lerr := say(log, family(ev.v6)+" answer in"); lerr != nil {
				return "", lerr
			}
		case evWaited:
			waited = true
			if !done6 {
				if lerr := say(log, "resolution delay passed without an AAAA answer"); lerr != nil {
					return "", lerr
				}
			}
		case evConnected:
			if lerr := say(log, "connected "+ev.addr); lerr != nil {
				return "", lerr
			}
			return ev.addr, nil
		case evFailed:
			inflight--
			mayStart = true
			if lerr := say(log, "failed "+ev.addr); lerr != nil {
				return "", lerr
			}
		case evTick:
			// The attempt is still running after AttemptDelay: start the next one beside it.
			if ev.seq == started && !mayStart && len(v6)+len(v4) > 0 {
				mayStart = true
				if lerr := say(log, "no answer from "+ev.addr+" after "+itoa(AttemptDelay)+"ms"); lerr != nil {
					return "", lerr
				}
			}
		}
	}
}

// attempt starts attempt seq to addr and its AttemptDelay timer, both in n.
func attempt(n *sgo.Nursery, d *sgo.Dialer, slot *sgo.ConnSlot, events *sgo.Channel[event], addr string, seq int) {
	n.Spawn(func(t *sgo.Context) error {
		conn, derr := d.Dial(t, addr)
		if derr != nil {
			if sgo.IsCancelled(derr) {
				return derr
			}
			return send(t, events, event{kind: evFailed, addr: addr, seq: seq})
		}
		if perr := slot.Put(conn); perr != nil {
			// Another attempt won: this connection is ours, so we close it.
			if cerr := conn.Close(); cerr != nil {
				return cerr
			}
			return nil
		}
		return send(t, events, event{kind: evConnected, addr: addr, seq: seq})
	})
	n.Spawn(func(t *sgo.Context) error {
		if serr := t.Sleep(AttemptDelay); serr != nil {
			return serr
		}
		return send(t, events, event{kind: evTick, addr: addr, seq: seq})
	})
}

// resolve runs one query (§3) and reports its addresses, then that it is done. A failed query
// counts as an answer without addresses.
func resolve(t *sgo.Context, d *sgo.Dialer, host string, v6 bool, events *sgo.Channel[event]) error {
	fam := "ip4"
	if v6 {
		fam = "ip6"
	}
	addrs, rerr := d.Resolve(host, fam)
	if rerr != nil && sgo.IsCancelled(rerr) {
		return rerr
	}
	for _, a := range addrs {
		if serr := send(t, events, event{kind: evAddr, v6: v6, addr: a}); serr != nil {
			return serr
		}
	}
	return send(t, events, event{kind: evDone, v6: v6})
}

func send(t *sgo.Context, events *sgo.Channel[event], ev event) error {
	p, err := events.Reserve(t)
	if err != nil {
		return err
	}
	return p.Commit(ev)
}

func say(log Logger, line string) error {
	if log == nil {
		return nil
	}
	return log.Log(line)
}

func family(v6 bool) string {
	if v6 {
		return "AAAA"
	}
	return "A"
}

func itoa(v int) string {
	if v == 0 {
		return "0"
	}
	s := ""
	for v > 0 {
		s = string(rune('0'+v%10)) + s
		v = v / 10
	}
	return s
}
