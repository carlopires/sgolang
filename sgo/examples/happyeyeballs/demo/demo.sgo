// Package demo runs one Happy Eyeballs race to example.test:443 for the lab scenarios. Each
// scenario's lab.net describes the network: what the names resolve to, after how long, and which
// addresses answer. Run fails unless the race reaches want, so `sgo lab sweep` checks the RFC 8305
// behavior under every schedule it tries.
package demo

import (
	"example.com/happyeyeballs/he"
	"sgo"
)

type trace struct{ lines []string }

func (t *trace) Log(line string) error {
	t.lines = append(t.lines, line)
	return nil
}

// Run races to example.test and prints the steps, then what the winning peer says. want is the
// address the race must reach ("" if every address must fail); step, if not "", is a step the
// race must take (the RFC 8305 rule the scenario is about).
func Run(root *sgo.Context, want, step string) error { return run(root, want, "", step, "") }

// RunOneOf is Run for a race whose winner depends on the schedule: it must reach want or alt.
func RunOneOf(root *sgo.Context, want, alt, step string) error { return run(root, want, alt, step, "") }

// RunWithout is Run, and it also fails if the race logged the step forbid (when forbid is not ""):
// the late-answer scenarios forbid the pending attempt's failure, which the race must not wait for.
func RunWithout(root *sgo.Context, want, step, forbid string) error {
	return run(root, want, "", step, forbid)
}

func run(root *sgo.Context, want, alt, step, forbid string) error {
	d := root.Dialer([]string{"example.test:443"})
	steps := &trace{}
	r, cerr := he.Connect(root, d, "example.test", steps)
	seen := step == ""
	for _, line := range steps.lines {
		check root.Stdout().WriteString(line + "\n")
		seen = seen || line == step
		if forbid != "" && line == forbid {
			return sgo.NewError("the race took the step " + forbid + ": it waited for the pending attempt to fail")
		}
	}
	if !seen {
		return sgo.NewError("the race did not take the step " + step)
	}
	if cerr != nil {
		if want == "" {
			return root.Stdout().WriteString("no connection, as expected\n")
		}
		return cerr
	}
	if r.Addr != want && (alt == "" || r.Addr != alt) {
		return sgo.NewError("the race reached " + r.Addr + ", not " + want)
	}
	msg := check ReadGreeting(r.Conn)
	return root.Stdout().WriteString("read: " + msg)
}

// ReadGreeting reads what the peer sends until it closes the connection, up to 256 bytes. A Read
// returns at least one byte but may return fewer than were sent (SGO-FILE-003), so one Read is
// not a whole message.
func ReadGreeting(c *sgo.Conn) (string, error) {
	got := ""
	for len(got) < 256 {
		s, err := c.Read(256 - len(got))
		if err != nil {
			if sgo.IsEOF(err) {
				return got, nil
			}
			return got, err
		}
		got = got + s
	}
	return got, nil
}

// failingLog fails at one step, as a Logger may (its Log returns an error).
type failingLog struct{ at string }

func (f *failingLog) Log(line string) error {
	if line == f.at {
		return sgo.NewError("log failed at " + line)
	}
	return nil
}

// RunLogFails races to example.test with a logger that fails at the step at, while attempts are
// still pending, and checks that Connect returns that error within maxMS virtual milliseconds:
// the race must cancel its pending work rather than wait for it (review HE-02).
func RunLogFails(root *sgo.Context, at string, maxMS int) error {
	d := root.Dialer([]string{"example.test:443"})
	clock := root.Clock()
	_, cerr := he.Connect(root, d, "example.test", &failingLog{at: at})
	if cerr == nil || cerr.Error() != "log failed at "+at {
		return sgo.NewError("Connect did not return the logger's error")
	}
	if ms := clock.Since(); ms > maxMS {
		return sgo.NewError("Connect returned after a pending attempt ended, not by cancelling it")
	}
	return root.Stdout().WriteString("connect stopped at the failed log: " + cerr.Error() + "\n")
}
