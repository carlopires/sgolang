// Command silent-v6 is a Happy Eyeballs lab scenario: IPv6 answers nothing, so IPv4 starts at 250ms and wins (see lab.net).
package main

import (
	"example.com/happyeyeballs/demo"
	"sgo"
)

func main(root *sgo.Context) error { return demo.Run(root, "192.0.2.1:443", "no answer from [2001:db8::1]:443 after 250ms") }
