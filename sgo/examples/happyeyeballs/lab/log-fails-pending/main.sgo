// Command log-fails-pending is a Happy Eyeballs lab scenario: the logger fails at IPv6's attempt
// delay while both attempts are pending (blackholes), so Connect must cancel them and return the
// logger's error at once, not after the pending attempts time out (review HE-02).
package main

import (
	"example.com/happyeyeballs/demo"
	"sgo"
)

func main(root *sgo.Context) error {
	return demo.RunLogFails(root, "no answer from [2001:db8::1]:443 after 250ms", 1000)
}
