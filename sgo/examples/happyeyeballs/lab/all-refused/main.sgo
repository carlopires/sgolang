// Command all-refused is a Happy Eyeballs lab scenario: every address refuses: the race ends with an error at once (see lab.net).
package main

import (
	"example.com/happyeyeballs/demo"
	"sgo"
)

func main(root *sgo.Context) error { return demo.Run(root, "", "failed [2001:db8::2]:443") }
