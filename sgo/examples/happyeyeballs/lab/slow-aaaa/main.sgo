// Command slow-aaaa is a Happy Eyeballs lab scenario: the AAAA answer is late, so IPv4 starts after the 50ms resolution delay (see lab.net).
package main

import (
	"example.com/happyeyeballs/demo"
	"sgo"
)

func main(root *sgo.Context) error { return demo.Run(root, "192.0.2.1:443", "resolution delay passed without an AAAA answer") }
