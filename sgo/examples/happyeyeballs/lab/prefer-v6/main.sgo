// Command prefer-v6 is a Happy Eyeballs lab scenario: the AAAA answer is inside the resolution delay, so IPv6 is tried first and wins (see lab.net).
package main

import (
	"example.com/happyeyeballs/demo"
	"sgo"
)

func main(root *sgo.Context) error { return demo.Run(root, "[2001:db8::1]:443", "") }
