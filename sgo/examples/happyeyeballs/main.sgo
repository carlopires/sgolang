// Command happyeyeballs connects to localhost with Happy Eyeballs (RFC 8305). A server listens on
// 127.0.0.1 only, so the preferred IPv6 address [::1] is refused and the race moves to IPv4 at
// once, without waiting out the 250ms attempt delay.
package main

import (
	"example.com/happyeyeballs/demo"
	"example.com/happyeyeballs/he"
	"sgo"
)

// trace collects the steps of the race.
type trace struct{ lines []string }

func (t *trace) Log(line string) error {
	t.lines = append(t.lines, line)
	return nil
}

func main(root *sgo.Context) error {
	l := check root.Listen("127.0.0.1:47970")
	d := root.Dialer([]string{"localhost:47970"})
	nursery (n) {
		n.Spawn(func(t *sgo.Context) error {
			s := check l.Accept(t)
			check s.Write("hello over the winning family\n")
			return nil // the accepted connection is a resource of this task: released here
		})
		if err := client(root, d); err != nil {
			n.Cancel() // the server may still wait in Accept: stop it before the nursery joins
			return err
		}
	}
	return nil // root's body ends: the connection, the dialer, and the listener are released
}

// client races to localhost, prints the attempts, and prints what the winning peer says.
func client(root *sgo.Context, d *sgo.Dialer) error {
	steps := &trace{}
	r, cerr := he.Connect(root, d, "localhost", steps)
	// The attempts, not the answers: which of the two answers comes first varies run to run.
	for _, line := range steps.lines {
		if !isAnswer(line) {
			check root.Stdout().WriteString("he: " + line + "\n")
		}
	}
	if cerr != nil {
		return cerr
	}
	msg := check demo.ReadGreeting(r.Conn)
	return root.Stdout().WriteString("reached " + r.Addr + ": " + msg)
}

func isAnswer(line string) bool { return line == "A answer in" || line == "AAAA answer in" }
