package main

import (
	"sgo"

	"example.com/httpserver/client"
	"example.com/httpserver/server"
)

const addr = "unix:http.sock"

// main runs the server and the demo client side by side, then shuts the server down: one Cancel
// of the server's nursery ends it, with the client's keep-alive connection still open.
func main(root *sgo.Context) error {
	nursery (n) {
		l := check n.Listen(addr) // a resource of n: released when the server's scope ends
		check n.Start(func(task *sgo.Context, ready *sgo.Ready) error {
			return server.Serve(task, l, ready)
		})
		out := check client.Demo(root, addr, server.ReadLimitMs)
		check root.Stdout().WriteString(out)
		n.Cancel()
	}
	return root.Stdout().WriteString("shut down with a keep-alive connection open\n")
}
