package server

import (
	"sgo"

	"example.com/httpserver/client"
	"example.com/httpserver/http"
)

const sock = "unix:http.sock"

// withServer serves on sock while run runs, then shuts the server down, whatever connections run
// left open, and returns what run returned.
func withServer(root *sgo.Context, run func(*sgo.Context, string) (string, error)) (string, error) {
	l := check root.Listen(sock)
	out := ""
	nursery (n) {
		check n.Start(func(task *sgo.Context, ready *sgo.Ready) error {
			return Serve(task, l, ready)
		})
		out = check run(root, sock)
		n.Cancel()
	}
	check l.Close()
	return out, nil
}

func keepAlive(r *sgo.Context, a string) (string, error) {
	c := check r.Dial(a)
	return client.Transcript(c, []string{"/slow", "/hello", "/slow"})
}

func TestKeepAliveAndDeadline(t *sgo.T) error {
	out := check withServer(t.Context(), keepAlive)
	want := "/slow -> Gateway Timeout: deadline\n/hello -> OK: hello\n/slow -> Gateway Timeout: deadline\n"
	if out != want {
		return sgo.NewError("transcript: " + out)
	}
	return nil
}

func idleOnly(r *sgo.Context, a string) (string, error) {
	_ = check r.Dial(a) // accepted, then left idle: the shutdown does not wait for it
	return "", nil
}

func TestShutdownIdle(t *sgo.T) error {
	_, err := withServer(t.Context(), idleOnly)
	return err
}

func hello(r *sgo.Context, a string) (string, error) {
	c := check r.Dial(a)
	return client.Transcript(c, []string{"/hello"})
}

func TestRestart(t *sgo.T) error {
	check withServer(t.Context(), hello)
	_, err := withServer(t.Context(), hello)
	return err
}

// rawThenHello sends raw on one connection, reads its response, then makes a normal request on
// another: a bad client must not take the server down (W23 review E1).
func rawThenHello(r *sgo.Context, a string, raw string) (string, error) {
	bad := check r.Dial(a)
	check bad.Write(raw)
	refused := check http.ReadResponse(bad)
	if refused.Status != 400 {
		return "", sgo.NewError("a malformed request was not refused")
	}
	good := check r.Dial(a)
	served := check client.Transcript(good, []string{"/hello"})
	return served, nil
}

func badLine(r *sgo.Context, a string) (string, error) {
	return rawThenHello(r, a, "GARBAGE\r\n\r\n")
}

func TestBadClient(t *sgo.T) error {
	out := check withServer(t.Context(), badLine)
	if out != "/hello -> OK: hello\n" {
		return sgo.NewError("after a bad client: " + out)
	}
	return nil
}

func statusOf(r *sgo.Context, a string, raw string) (string, error) {
	c := check r.Dial(a)
	check c.Write(raw)
	resp := check http.ReadResponse(c)
	return client.Line("raw", resp), nil
}

func tooLarge(r *sgo.Context, a string) (string, error) {
	return statusOf(r, a, "POST /x HTTP/1.1\r\nContent-Length: 99999999999\r\n\r\n")
}

func TestBodyTooLarge(t *sgo.T) error {
	out := check withServer(t.Context(), tooLarge)
	if out != "raw -> Payload Too Large: body of 99999999999 bytes\n" {
		return sgo.NewError("got " + out)
	}
	return nil
}

func chunked(r *sgo.Context, a string) (string, error) {
	return statusOf(r, a, "POST /x HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n")
}

func TestChunkedRefused(t *sgo.T) error {
	out := check withServer(t.Context(), chunked)
	if out != "raw -> Bad Request: Transfer-Encoding is not supported\n" {
		return sgo.NewError("got " + out)
	}
	return nil
}
