package bits

import "sgo"

func TestCarries(t *sgo.T) error {
	s, c := Add64(0xffffffffffffffff, 1, 0)
	if s != 0 || c != 1 {
		return sgo.NewError("Add64 carry")
	}
	d, b := Sub32(0, 1, 0)
	if d != 0xffffffff || b != 1 {
		return sgo.NewError("Sub32 borrow")
	}
	hi, lo := Mul64(0xffffffffffffffff, 0xffffffffffffffff)
	if hi != 0xfffffffffffffffe || lo != 1 {
		return sgo.NewError("Mul64")
	}
	q, r := Div64(1, 0, 3)
	if q != 0x5555555555555555 || r != 1 {
		return sgo.NewError("Div64")
	}
	return nil
}

func TestCounts(t *sgo.T) error {
	if RotateLeft32(0x80000001, 1) != 3 || RotateLeft64(1, -1) != 0x8000000000000000 {
		return sgo.NewError("rotate")
	}
	if Len64(0) != 0 || Len32(0xff) != 8 || LeadingZeros64(1) != 63 || TrailingZeros32(0) != 32 {
		return sgo.NewError("lengths")
	}
	if OnesCount32(0xf0f0) != 8 || ReverseBytes64(0x0102030405060708) != 0x0807060504030201 {
		return sgo.NewError("counts")
	}
	return nil
}
