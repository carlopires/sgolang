// Package bits provides the modular arithmetic, carries, and bit counts of Go's math/bits for
// uint32 and uint64 (SGO-STD-011, D196). S-Go arithmetic never wraps (SGO-TYPE-009): these
// functions are where wrapping is written, with the carry or borrow returned.
//
// Each function gives Go's result for every input, including Go's results for a carry or borrow
// input other than 0 or 1. Div32 and Div64 fail where Go's panic: DivideByZero for a zero
// divisor and IntegerOverflow when the quotient does not fit (y <= hi).
package bits

const m32 = 0xffffffff

// addMod64 is x + y modulo 2^64, computed on 32-bit halves so no sum leaves the range.
func addMod64(x, y uint64) uint64 {
	lo := (x & m32) + (y & m32)
	hi := (x >> 32) + (y >> 32) + (lo >> 32)
	return (hi&m32)<<32 | lo&m32
}

// negMod64 is -x modulo 2^64.
func negMod64(x uint64) uint64 {
	var one uint64 = 1
	return addMod64(^x, one)
}

// Add32 returns x + y + carry modulo 2^32 and the carry out (carry is 0 or 1).
func Add32(x, y, carry uint32) (sum, carryOut uint32) {
	s := uint64(x) + uint64(y) + uint64(carry)
	sum = uint32(s & m32)
	carryOut = ((x & y) | ((x | y) &^ sum)) >> 31
	return sum, carryOut
}

// Add64 returns x + y + carry modulo 2^64 and the carry out (carry is 0 or 1).
func Add64(x, y, carry uint64) (sum, carryOut uint64) {
	sum = addMod64(addMod64(x, y), carry)
	carryOut = ((x & y) | ((x | y) &^ sum)) >> 63
	return sum, carryOut
}

// Sub32 returns x - y - borrow modulo 2^32 and the borrow out (borrow is 0 or 1).
func Sub32(x, y, borrow uint32) (diff, borrowOut uint32) {
	d := (uint64(x) | 0x300000000) - uint64(y) - uint64(borrow)
	diff = uint32(d & m32)
	borrowOut = ((^x & y) | (^(x ^ y) & diff)) >> 31
	return diff, borrowOut
}

// Sub64 returns x - y - borrow modulo 2^64 and the borrow out (borrow is 0 or 1).
func Sub64(x, y, borrow uint64) (diff, borrowOut uint64) {
	diff = addMod64(addMod64(x, negMod64(y)), negMod64(borrow))
	borrowOut = ((^x & y) | (^(x ^ y) & diff)) >> 63
	return diff, borrowOut
}

// Mul32 returns the 64-bit product of x and y as its high and low halves.
func Mul32(x, y uint32) (hi, lo uint32) {
	p := uint64(x) * uint64(y)
	return uint32(p >> 32), uint32(p & m32)
}

// Mul64 returns the 128-bit product of x and y as its high and low halves.
func Mul64(x, y uint64) (hi, lo uint64) {
	x0 := x & m32
	x1 := x >> 32
	y0 := y & m32
	y1 := y >> 32
	w0 := x0 * y0
	t := x1*y0 + w0>>32
	w1 := t & m32
	w2 := t >> 32
	w1 = w1 + x0*y1
	hi = x1*y1 + w2 + w1>>32
	lo = (w1&m32)<<32 | w0&m32
	return hi, lo
}

// Div32 returns the quotient and remainder of (hi, lo) divided by y. It fails with
// DivideByZero for y == 0 and with IntegerOverflow for y <= hi, as Go's panics.
func Div32(hi, lo, y uint32) (quo, rem uint32) {
	if y == 0 {
		_ = hi / y // DivideByZero
	}
	if y <= hi {
		_ = y - hi - 1 // IntegerOverflow: the quotient does not fit in 32 bits
	}
	n := uint64(hi)<<32 | uint64(lo)
	d := uint64(y)
	return uint32(n / d), uint32(n % d)
}

// Div64 returns the quotient and remainder of (hi, lo) divided by y. It fails with
// DivideByZero for y == 0 and with IntegerOverflow for y <= hi, as Go's panics.
func Div64(hi, lo, y uint64) (quo, rem uint64) {
	if y == 0 {
		_ = hi / y // DivideByZero
	}
	if y <= hi {
		_ = y - hi - 1 // IntegerOverflow: the quotient does not fit in 64 bits
	}
	var one uint64 = 1
	rem = hi
	for i := 63; i >= 0; i-- {
		top := rem >> 63
		rem = (rem&0x7fffffffffffffff)<<1 | (lo>>i)&1
		if top == 1 || rem >= y {
			rem = addMod64(rem, negMod64(y))
			quo = quo | one<<i
		}
	}
	return quo, rem
}

// RotateLeft32 returns x rotated left by (k mod 32) bits; a negative k rotates right.
func RotateLeft32(x uint32, k int) uint32 {
	s := k & 31
	v := uint64(x)
	return uint32((v<<s | v>>(32-s)) & m32)
}

// RotateLeft64 returns x rotated left by (k mod 64) bits; a negative k rotates right.
func RotateLeft64(x uint64, k int) uint64 {
	s := k & 63
	if s == 0 {
		return x
	}
	var one uint64 = 1
	low := (one << (64 - s)) - 1
	return (x&low)<<s | x>>(64-s)
}

// Len32 returns the number of bits needed to represent x; 0 for x == 0.
func Len32(x uint32) int {
	return Len64(uint64(x))
}

// Len64 returns the number of bits needed to represent x; 0 for x == 0.
func Len64(x uint64) int {
	n := 0
	for x != 0 {
		x = x >> 1
		n++
	}
	return n
}

// LeadingZeros32 returns the number of leading zero bits in x; 32 for x == 0.
func LeadingZeros32(x uint32) int {
	return 32 - Len32(x)
}

// LeadingZeros64 returns the number of leading zero bits in x; 64 for x == 0.
func LeadingZeros64(x uint64) int {
	return 64 - Len64(x)
}

// TrailingZeros32 returns the number of trailing zero bits in x; 32 for x == 0.
func TrailingZeros32(x uint32) int {
	if x == 0 {
		return 32
	}
	return TrailingZeros64(uint64(x))
}

// TrailingZeros64 returns the number of trailing zero bits in x; 64 for x == 0.
func TrailingZeros64(x uint64) int {
	if x == 0 {
		return 64
	}
	n := 0
	for x&1 == 0 {
		x = x >> 1
		n++
	}
	return n
}

// OnesCount32 returns the number of one bits in x.
func OnesCount32(x uint32) int {
	return OnesCount64(uint64(x))
}

// OnesCount64 returns the number of one bits in x.
func OnesCount64(x uint64) int {
	n := 0
	for x != 0 {
		n = n + int(x&1)
		x = x >> 1
	}
	return n
}

// ReverseBytes32 returns x with its bytes in reverse order.
func ReverseBytes32(x uint32) uint32 {
	return x>>24 | (x>>8)&0xff00 | (x&0xff00)<<8 | (x&0xff)<<24
}

// ReverseBytes64 returns x with its bytes in reverse order.
func ReverseBytes64(x uint64) uint64 {
	lo := ReverseBytes32(uint32(x & m32))
	hi := ReverseBytes32(uint32(x >> 32))
	return uint64(lo)<<32 | uint64(hi)
}
