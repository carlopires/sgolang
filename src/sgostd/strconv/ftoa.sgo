package strconv

import "std/math"

// float64 layout (Go's floatInfo for float64).
const (
	mantBits = 52
	expBits  = 11
	bias     = -1023
)

const upperhex = "0123456789ABCDEF"

// FormatFloat returns the text of f in the format fmt with precision prec, as Go's
// strconv.FormatFloat(f, fmt, prec, 64) (D193): 'e' and 'E' (-d.dddde±dd), 'f' (-ddd.dddd), 'g'
// and 'G' ('e' for large exponents, 'f' otherwise), 'b' (-ddddp±ddd, a binary exponent), and 'x'
// and 'X' (-0xd.ddddp±ddd, a hexadecimal fraction and binary exponent). prec is the number of
// digits after the point for 'e', 'E', 'f', 'x', and 'X', and the number of significant digits for
// 'g' and 'G'; -1 means the fewest digits that read back exactly. It is computed with Go's exact
// multiprecision algorithm, so the text is the same as Go's on every target.
func FormatFloat(f float64, fmt byte, prec int) string {
	b := math.Float64bits(f)
	neg := b < 0
	exp := (b >> mantBits) & (1<<expBits - 1)
	mant := b & (1<<mantBits - 1)

	switch exp {
	case 1<<expBits - 1:
		// Inf, NaN
		switch {
		case mant != 0:
			return "NaN"
		case neg:
			return "-Inf"
		}
		return "+Inf"
	case 0:
		// denormalized
		exp++
	default:
		// add implicit top bit
		mant |= 1 << mantBits
	}
	exp += bias

	// Pick off the easy binary and hex formats.
	if fmt == 'b' {
		return string(fmtB(neg, mant, exp))
	}
	if fmt == 'x' || fmt == 'X' {
		return string(fmtX(prec, fmt, neg, mant, exp))
	}
	return string(bigFtoa(prec, fmt, neg, mant, exp))
}

// bigFtoa formats mant * 2^(exp-mantBits) with multiprecision decimal arithmetic.
func bigFtoa(prec int, fmt byte, neg bool, mant int, exp int) []byte {
	d := &decimal{}
	d.assign(mant)
	d.shift(exp - mantBits)
	shortest := prec < 0
	if shortest {
		roundShortest(d, mant, exp)
		// Precision for shortest representation mode.
		switch fmt {
		case 'e', 'E':
			prec = d.nd - 1
		case 'f':
			prec = d.nd - d.dp
			if prec < 0 {
				prec = 0
			}
		case 'g', 'G':
			prec = d.nd
		}
	} else {
		// Round appropriately.
		switch fmt {
		case 'e', 'E':
			d.round(prec + 1)
		case 'f':
			d.round(d.dp + prec)
		case 'g', 'G':
			if prec == 0 {
				prec = 1
			}
			d.round(prec)
		}
	}
	return formatDigits(shortest, neg, d, prec, fmt)
}

func formatDigits(shortest bool, neg bool, d *decimal, prec int, fmt byte) []byte {
	switch fmt {
	case 'e', 'E':
		return fmtE(neg, d, prec, fmt)
	case 'f':
		return fmtF(neg, d, prec)
	case 'g', 'G':
		// trailing fractional zeros in 'e' form will be trimmed.
		eprec := prec
		if eprec > d.nd && d.nd >= d.dp {
			eprec = d.nd
		}
		// %e is used if the exponent from the conversion is less than -4 or greater than or equal
		// to the precision. If the precision was the shortest possible, use precision 6 for this
		// decision.
		if shortest {
			eprec = 6
		}
		exp := d.dp - 1
		if exp < -4 || exp >= eprec {
			if prec > d.nd {
				prec = d.nd
			}
			return fmtE(neg, d, prec-1, fmt+'e'-'g')
		}
		if prec > d.dp {
			prec = d.nd
		}
		p := prec - d.dp
		if p < 0 {
			p = 0
		}
		return fmtF(neg, d, p)
	}
	// unknown format
	return []byte{'%', fmt}
}

// roundShortest rounds d (= mant * 2^(exp-mantBits)) to the shortest number of digits that will
// let the original floating point value be precisely reconstructed.
func roundShortest(d *decimal, mant int, exp int) {
	// If mantissa is zero, the number is zero; stop now.
	if mant == 0 {
		d.nd = 0
		return
	}

	// Compute upper and lower such that any decimal number between upper and lower (possibly
	// inclusive) will round to the original floating point number. We may see at once that the
	// number is already shortest: if the exponent is not the minimum and there are at most as
	// many decimal digits as the binary precision allows.
	minexp := bias + 1 // minimum possible exponent
	if exp > minexp && 332*(d.dp-d.nd) >= 100*(exp-mantBits) {
		// The number is already shortest.
		return
	}

	// d = mant << (exp - mantBits). Next highest floating point number is mant+1 << exp-mantBits.
	// Our upper bound is halfway between, mant*2+1 << exp-mantBits-1.
	upper := &decimal{}
	upper.assign(mant*2 + 1)
	upper.shift(exp - mantBits - 1)

	// d = mant << (exp - mantBits). Next lowest floating point number is mant-1 << exp-mantBits,
	// unless mant-1 drops the significant bit and exp is not the minimum exp, in which case the
	// next lowest is mant*2-1 << exp-mantBits-1. Either way, call it mantlo << explo-mantBits.
	// Our lower bound is halfway between, mantlo*2+1 << explo-mantBits-1.
	mantlo := 0
	explo := 0
	if mant > 1<<mantBits || exp == minexp {
		mantlo = mant - 1
		explo = exp
	} else {
		mantlo = mant*2 - 1
		explo = exp - 1
	}
	lo := &decimal{}
	lo.assign(mantlo*2 + 1)
	lo.shift(explo - mantBits - 1)

	// The upper and lower bounds are possible outputs only if the original mantissa is even, so
	// that IEEE round-to-even would round to the original mantissa and not the neighbors.
	inclusive := mant%2 == 0

	// As we walk the digits we want to know whether the original float is identical to the lower
	// bound or the upper bound, and whether we can stop: upperdelta tracks how far the upper bound
	// is from d at the digits seen so far.
	upperdelta := 0

	// Now we can figure out the minimum number of digits required. Walk along until d has
	// distinguished itself from upper and lower.
	for ui := 0; ; ui++ {
		// lower, d, and upper may have the decimal point at different places. In that case upper
		// is the longest, so we iterate from ui==0 and start li and mi at (possibly) -1.
		mi := ui - upper.dp + d.dp
		if mi >= d.nd {
			break
		}
		li := ui - upper.dp + lo.dp
		var l byte = '0' // lower digit
		if li >= 0 && li < lo.nd {
			l = lo.d[li]
		}
		var m byte = '0' // middle digit
		if mi >= 0 {
			m = d.d[mi]
		}
		var u byte = '0' // upper digit
		if ui < upper.nd {
			u = upper.d[ui]
		}

		// Okay to round down (truncate) if lower has a different digit or if lower is inclusive
		// and is exactly the result of rounding down (i.e., and we have reached the final digit
		// of lower).
		okdown := l != m || inclusive && li+1 == lo.nd

		switch {
		case upperdelta == 0 && m+1 < u:
			// Example: m = 12345xxx, u = 12347xxx
			upperdelta = 2
		case upperdelta == 0 && m != u:
			// Example: m = 12345xxx, u = 12346xxx
			upperdelta = 1
		case upperdelta == 1 && (m != '9' || u != '0'):
			// Example: m = 1234598x, u = 1234600x
			upperdelta = 2
		}
		// Okay to round up if upper has a different digit and either upper is inclusive or upper
		// is bigger than the result of rounding up.
		okup := upperdelta > 0 && (inclusive || upperdelta > 1 || ui+1 < upper.nd)

		// If it's okay to do either, then round to the nearest one. If it's okay to do only one,
		// do it.
		switch {
		case okdown && okup:
			d.round(mi + 1)
			return
		case okdown:
			d.roundDown(mi + 1)
			return
		case okup:
			d.roundUp(mi + 1)
			return
		}
	}
}

// fmtE formats %e: -d.ddddde±dd.
func fmtE(neg bool, d *decimal, prec int, fmt byte) []byte {
	dst := []byte{}
	if neg {
		dst = append(dst, '-')
	}

	// first digit
	var ch byte = '0'
	if d.nd != 0 {
		ch = d.d[0]
	}
	dst = append(dst, ch)

	// .moredigits
	if prec > 0 {
		dst = append(dst, '.')
		i := 1
		m := d.nd
		if prec+1 < m {
			m = prec + 1
		}
		for ; i < m; i++ {
			dst = append(dst, d.d[i])
		}
		for ; i <= prec; i++ {
			dst = append(dst, '0')
		}
	}

	// e±
	dst = append(dst, fmt)
	exp := d.dp - 1
	if d.nd == 0 { // special case: 0 has exponent 0
		exp = 0
	}
	if exp < 0 {
		ch = '-'
		exp = -exp
	} else {
		ch = '+'
	}
	dst = append(dst, ch)

	// dd or ddd
	switch {
	case exp < 10:
		dst = append(dst, '0', byte(exp)+'0')
	case exp < 100:
		dst = append(dst, byte(exp/10)+'0', byte(exp%10)+'0')
	default:
		dst = append(dst, byte(exp/100)+'0', byte(exp/10%10)+'0', byte(exp%10)+'0')
	}
	return dst
}

// fmtF formats %f: -ddddddd.ddddd.
func fmtF(neg bool, d *decimal, prec int) []byte {
	dst := []byte{}
	if neg {
		dst = append(dst, '-')
	}

	// integer, padded with zeros as needed.
	if d.dp > 0 {
		m := d.nd
		if d.dp < m {
			m = d.dp
		}
		for i := 0; i < m; i++ {
			dst = append(dst, d.d[i])
		}
		for ; m < d.dp; m++ {
			dst = append(dst, '0')
		}
	} else {
		dst = append(dst, '0')
	}

	// fraction
	if prec > 0 {
		dst = append(dst, '.')
		for i := 0; i < prec; i++ {
			var ch byte = '0'
			j := d.dp + i
			if 0 <= j && j < d.nd {
				ch = d.d[j]
			}
			dst = append(dst, ch)
		}
	}
	return dst
}

// fmtB formats %b: -ddddddddp±ddd.
func fmtB(neg bool, mant int, exp int) []byte {
	s := ""
	if neg {
		s = "-"
	}
	s += Itoa(mant) + "p"
	exp -= mantBits
	if exp >= 0 {
		s += "+"
	}
	return []byte(s + Itoa(exp))
}

// fmtX formats %x: -0x1.yyyyyyyyp±ddd or -0x0p+0. (y is hex digit, d is decimal digit)
func fmtX(prec int, fmt byte, neg bool, mant int, exp int) []byte {
	if mant == 0 {
		exp = 0
	}

	// Shift digits so the leading 1 (if any) is at bit 1<<60.
	mant <<= 60 - mantBits
	for mant != 0 && mant&(1<<60) == 0 {
		mant <<= 1
		exp--
	}

	// Round if requested.
	if prec >= 0 && prec < 15 {
		shift := prec * 4
		extra := (mant & (1<<(60-shift) - 1)) << shift // Go's (mant << shift) & (1<<60 - 1)
		mant >>= 60 - shift
		if extra|(mant&1) > 1<<59 {
			mant++
		}
		mant <<= 60 - shift
		if mant&(1<<61) != 0 {
			// Wrapped around.
			mant >>= 1
			exp++
		}
	}

	hex := lowerhex
	if fmt == 'X' {
		hex = upperhex
	}

	// sign, 0x, leading digit
	dst := []byte{}
	if neg {
		dst = append(dst, '-')
	}
	dst = append(dst, '0', fmt, '0'+byte((mant>>60)&1))

	// .fraction: the 60 bits below the leading digit, read 4 at a time.
	frac := mant & (1<<60 - 1)
	if prec < 0 && frac != 0 {
		dst = append(dst, '.')
		for frac != 0 {
			dst = append(dst, hex[frac>>56])
			frac = (frac & (1<<56 - 1)) << 4
		}
	} else if prec > 0 {
		dst = append(dst, '.')
		for i := 0; i < prec; i++ {
			dst = append(dst, hex[frac>>56])
			frac = (frac & (1<<56 - 1)) << 4
		}
	}

	// p±
	var ch byte = 'P'
	if fmt == lower(fmt) {
		ch = 'p'
	}
	dst = append(dst, ch)
	if exp < 0 {
		ch = '-'
		exp = -exp
	} else {
		ch = '+'
	}
	dst = append(dst, ch)

	// dd or ddd or dddd
	switch {
	case exp < 100:
		dst = append(dst, byte(exp/10)+'0', byte(exp%10)+'0')
	case exp < 1000:
		dst = append(dst, byte(exp/100)+'0', byte(exp/10%10)+'0', byte(exp%10)+'0')
	default:
		dst = append(dst, byte(exp/1000)+'0', byte(exp/100%10)+'0', byte(exp/10%10)+'0', byte(exp%10)+'0')
	}
	return dst
}
