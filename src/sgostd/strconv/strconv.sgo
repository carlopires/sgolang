// Package strconv converts between integers and their decimal text (SGO-IMP-004).
package strconv

import "sgo"

const minInt = -9223372036854775807 - 1

// Itoa returns the decimal text of v: an optional minus sign followed by digits, with no leading
// zeros.
func Itoa(v int) string {
	if v == 0 {
		return "0"
	}
	neg := v < 0
	b := []byte{}
	// Work with a non-positive value so that the minimum int needs no negation.
	n := v
	if !neg {
		n = -v
	}
	for n != 0 {
		d := -(n % 10)
		b = append(b, byte(48+d))
		n = n / 10
	}
	if neg {
		b = append(b, 45)
	}
	for i, j := 0, len(b)-1; i < j; i, j = i+1, j-1 {
		b[i], b[j] = b[j], b[i]
	}
	return string(b)
}

// Atoi parses s as an optionally signed decimal integer. It returns an error if s is empty, has a
// character that is not a digit (after one optional leading + or -), or is out of the range of int.
func Atoi(s string) (int, error) {
	if len(s) == 0 {
		return 0, sgo.NewError("strconv.Atoi: empty string")
	}
	i := 0
	neg := false
	if s[0] == 43 || s[0] == 45 {
		neg = s[0] == 45
		i = 1
		if len(s) == 1 {
			return 0, sgo.NewError("strconv.Atoi: no digits in " + quote(s))
		}
	}
	// Accumulate a non-positive value, which reaches the minimum int without overflow.
	n := 0
	for ; i < len(s); i++ {
		c := s[i]
		if c < 48 || c > 57 {
			return 0, sgo.NewError("strconv.Atoi: invalid digit in " + quote(s))
		}
		d := int(c) - 48
		if n < (minInt+d)/10 {
			return 0, sgo.NewError("strconv.Atoi: " + quote(s) + " is out of range")
		}
		n = n*10 - d
	}
	if neg {
		return n, nil
	}
	if n == minInt {
		return 0, sgo.NewError("strconv.Atoi: " + quote(s) + " is out of range")
	}
	return -n, nil
}

// quote returns s between double quotes, for error messages.
func quote(s string) string {
	return "\"" + s + "\""
}
