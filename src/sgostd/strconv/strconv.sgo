// Package strconv converts between integers, booleans, and their text, and quotes strings
// (SGO-STD-004), as Go's strconv for the functions it shares with it. int is the only integer
// type, so ParseInt has no bitSize. Error messages are Go's, with the input quoted by
// QuoteToASCII (D121, D125).
package strconv

import "sgo"

const (
	maxInt = 9223372036854775807
	minInt = -9223372036854775807 - 1
	two32  = 1 << 32
	two31  = 1 << 31
)

// numError builds Go's NumError message: strconv.<fn>: parsing "<s>": <msg>.
func numError(fn, s, msg string) error {
	return sgo.NewError("strconv." + fn + ": parsing " + QuoteToASCII(s) + ": " + msg)
}

// Itoa returns the decimal text of v.
func Itoa(v int) string {
	return FormatInt(v, 10)
}

// FormatInt returns the text of v in the given base (2 to 36), with lower-case letters for digits
// of 10 and above. Any other base panics, as in Go.
func FormatInt(v int, base int) string {
	if base < 2 || base > 36 {
		panic("strconv: illegal AppendInt/FormatInt base")
	}
	if v == 0 {
		return "0"
	}
	const digits = "0123456789abcdefghijklmnopqrstuvwxyz"
	b := make([]byte, 0, 65)
	// Work with a non-positive value, so that the minimum int needs no negation.
	n := v
	if n > 0 {
		n = -n
	}
	for n != 0 {
		b = append(b, digits[-(n%base)])
		n = n / base
	}
	if v < 0 {
		b = append(b, '-')
	}
	for i, j := 0, len(b)-1; i < j; i, j = i+1, j-1 {
		b[i], b[j] = b[j], b[i]
	}
	return string(b)
}

func lower(c byte) byte {
	if 'A' <= c && c <= 'Z' {
		return c + 32
	}
	return c
}

// underscoreOK reports whether the underscores in s are allowed, as Go's underscoreOK: only
// between digits, or between a base prefix and a digit.
func underscoreOK(s string) bool {
	var saw byte = '^'
	i := 0
	if len(s) >= 1 && (s[0] == '-' || s[0] == '+') {
		s = s[1:]
	}
	hex := false
	if len(s) >= 2 && s[0] == '0' && (lower(s[1]) == 'b' || lower(s[1]) == 'o' || lower(s[1]) == 'x') {
		i = 2
		saw = '0'
		hex = lower(s[1]) == 'x'
	}
	for ; i < len(s); i++ {
		if '0' <= s[i] && s[i] <= '9' || hex && 'a' <= lower(s[i]) && lower(s[i]) <= 'f' {
			saw = '0'
			continue
		}
		if s[i] == '_' {
			if saw != '0' {
				return false
			}
			saw = '_'
			continue
		}
		if saw == '_' {
			return false
		}
		saw = '!'
	}
	return saw != '_'
}

// parseMagnitude parses the unsigned digits of s as Go's ParseUint with bitSize 64 does. The
// value is kept as hi*2^32 + lo (each half below 2^32), so overflow past 2^64-1 is detected at
// the same digit as Go's. It returns the halves, and "" or the error kind ("syntax", "range",
// "base").
func parseMagnitude(s string, base int) (int, int, string) {
	if s == "" {
		return 0, 0, "syntax"
	}
	base0 := base == 0
	s0 := s
	switch {
	case 2 <= base && base <= 36:
	case base == 0:
		base = 10
		if s[0] == '0' {
			switch {
			case len(s) >= 3 && lower(s[1]) == 'b':
				base = 2
				s = s[2:]
			case len(s) >= 3 && lower(s[1]) == 'o':
				base = 8
				s = s[2:]
			case len(s) >= 3 && lower(s[1]) == 'x':
				base = 16
				s = s[2:]
			default:
				base = 8
				s = s[1:]
			}
		}
	default:
		return 0, 0, "base"
	}
	underscores := false
	hi, lo := 0, 0
	for i := 0; i < len(s); i++ {
		c := s[i]
		d := 0
		switch {
		case c == '_' && base0:
			underscores = true
			continue
		case '0' <= c && c <= '9':
			d = int(c) - '0'
		case 'a' <= lower(c) && lower(c) <= 'z':
			d = int(lower(c)) - 'a' + 10
		default:
			return 0, 0, "syntax"
		}
		if d >= base {
			return 0, 0, "syntax"
		}
		lo = lo*base + d
		carry := lo / two32
		lo = lo % two32
		hi = hi*base + carry
		if hi >= two32 {
			return two32 - 1, two32 - 1, "range"
		}
	}
	if underscores && !underscoreOK(s0) {
		return 0, 0, "syntax"
	}
	return hi, lo, ""
}

// parseInt is ParseInt with the function name fn used in errors.
func parseInt(fn, s string, base int) (int, error) {
	if s == "" {
		return 0, numError(fn, s, "invalid syntax")
	}
	s0 := s
	neg := false
	if s[0] == '+' {
		s = s[1:]
	} else if s[0] == '-' {
		neg = true
		s = s[1:]
	}
	hi, lo, kind := parseMagnitude(s, base)
	switch kind {
	case "syntax":
		return 0, numError(fn, s0, "invalid syntax")
	case "base":
		return 0, numError(fn, s0, "invalid base "+Itoa(base))
	}
	// The magnitude is hi*2^32 + lo; the bound is 2^63 = two31*2^32.
	if !neg && hi >= two31 {
		return maxInt, numError(fn, s0, "value out of range")
	}
	if neg && (hi > two31 || hi == two31 && lo > 0) {
		return minInt, numError(fn, s0, "value out of range")
	}
	if neg && hi == two31 {
		return minInt, nil
	}
	v := hi*two32 + lo
	if neg {
		return -v, nil
	}
	return v, nil
}

// ParseInt interprets s in the given base (0, or 2 to 36) and returns its value, as Go's
// strconv.ParseInt with bitSize 64. Base 0 takes the base from a prefix (0b, 0o, 0x, or a leading
// 0 for octal) and admits underscores between digits. A value out of range returns the nearest
// int and an error.
func ParseInt(s string, base int) (int, error) {
	return parseInt("ParseInt", s, base)
}

// Atoi is ParseInt(s, 10), with "Atoi" naming the function in errors.
func Atoi(s string) (int, error) {
	return parseInt("Atoi", s, 10)
}

// ParseBool returns the boolean value of s: 1, t, T, TRUE, true, True, 0, f, F, FALSE, false,
// or False; any other s is an error.
func ParseBool(s string) (bool, error) {
	switch s {
	case "1", "t", "T", "true", "TRUE", "True":
		return true, nil
	case "0", "f", "F", "false", "FALSE", "False":
		return false, nil
	}
	return false, numError("ParseBool", s, "invalid syntax")
}

// FormatBool returns "true" or "false".
func FormatBool(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
