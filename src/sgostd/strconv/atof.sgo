package strconv

import "std/math"

// ParseFloat returns the float64 nearest to the text s, as Go's strconv.ParseFloat(s, 64) (D193):
// a decimal or hexadecimal ("0x1.8p3") floating-point number with an optional sign, underscores
// only as Go allows them, or "inf", "infinity", or "nan" in any case. The result is correctly
// rounded (to nearest, ties to even). A number too large returns ±Inf and a "value out of range"
// error; bad text returns 0 and an "invalid syntax" error. It uses Go's exact multiprecision
// algorithm, so the result is the same as Go's on every target.
func ParseFloat(s string) (float64, error) {
	f, n, msg := atof64(s)
	if n != len(s) {
		return 0, numError("ParseFloat", s, "invalid syntax")
	}
	if msg != "" {
		return f, numError("ParseFloat", s, msg)
	}
	return f, nil
}

func commonPrefixLenIgnoreCase(s, prefix string) int {
	n := len(prefix)
	if len(s) < n {
		n = len(s)
	}
	for i := 0; i < n; i++ {
		c := s[i]
		if 'A' <= c && c <= 'Z' {
			c += 'a' - 'A'
		}
		if c != prefix[i] {
			return i
		}
	}
	return n
}

// special checks for an infinity or NaN at the start of s; it returns the value, the number of
// bytes read, and whether it found one.
func special(s string) (float64, int, bool) {
	if len(s) == 0 {
		return 0, 0, false
	}
	sign := 1
	nsign := 0
	c := s[0]
	if c == '+' || c == '-' {
		if c == '-' {
			sign = -1
		}
		nsign = 1
		s = s[1:]
		c = 'i' // Go falls through to the infinity case after a sign
	}
	switch c {
	case 'i', 'I':
		n := commonPrefixLenIgnoreCase(s, "infinity")
		// Anything longer than "inf" is ok, but if we don't have "infinity", only consume "inf".
		if 3 < n && n < 8 {
			n = 3
		}
		if n == 3 || n == 8 {
			return math.Inf(sign), nsign + n, true
		}
	case 'n', 'N':
		if commonPrefixLenIgnoreCase(s, "nan") == 3 {
			return math.NaN(), 3, true
		}
	}
	return 0, 0, false
}

// set reads the decimal number s into b, reporting whether it is well formed.
func (b *decimal) set(s string) bool {
	i := 0
	b.neg = false
	b.trunc = false

	// optional sign
	if i >= len(s) {
		return false
	}
	switch s[i] {
	case '+':
		i++
	case '-':
		i++
		b.neg = true
	}

	// digits
	sawdot := false
	sawdigits := false
	for ; i < len(s); i++ {
		c := s[i]
		if c == '_' {
			// readFloat already checked underscores
			continue
		}
		if c == '.' {
			if sawdot {
				return false
			}
			sawdot = true
			b.dp = b.nd
			continue
		}
		if '0' <= c && c <= '9' {
			sawdigits = true
			if c == '0' && b.nd == 0 { // ignore leading zeros
				b.dp--
				continue
			}
			if b.nd < len(b.d) {
				b.d[b.nd] = c
				b.nd++
			} else if c != '0' {
				b.trunc = true
			}
			continue
		}
		break
	}
	if !sawdigits {
		return false
	}
	if !sawdot {
		b.dp = b.nd
	}

	// optional exponent moves decimal point. If we read a very large, very long number, just be
	// sure to move the decimal point by a lot (say, 100000). It doesn't matter if it's not the
	// exact number.
	if i < len(s) && lower(s[i]) == 'e' {
		i++
		if i >= len(s) {
			return false
		}
		esign := 1
		switch s[i] {
		case '+':
			i++
		case '-':
			i++
			esign = -1
		}
		if i >= len(s) || s[i] < '0' || s[i] > '9' {
			return false
		}
		e := 0
		for ; i < len(s) && ('0' <= s[i] && s[i] <= '9' || s[i] == '_'); i++ {
			if s[i] == '_' {
				// readFloat already checked underscores
				continue
			}
			if e < 10000 {
				e = e*10 + int(s[i]-'0')
			}
		}
		b.dp += e * esign
	}

	return i == len(s)
}

// floatReading is the result of readFloat.
type floatReading struct {
	mantissa int  // the leading digits (hexadecimal numbers only)
	exp      int  // the binary exponent of mantissa (hexadecimal numbers only)
	neg      bool // a leading '-'
	trunc    bool // nonzero digits beyond those in mantissa
	hex      bool // a hexadecimal number
	n        int  // the bytes read
	ok       bool // well formed
}

// readFloat reads a decimal or hexadecimal floating-point number prefix of s (Go's readFloat).
// Only hexadecimal numbers use the mantissa, read to at most 15 digits (60 bits, so it fits int;
// Go reads 16): further nonzero digits set trunc, which feeds the same sticky bit when rounding.
func readFloat(s string) floatReading {
	r := floatReading{}
	underscores := false

	// optional sign
	i := 0
	if i >= len(s) {
		return r
	}
	switch s[i] {
	case '+':
		i++
	case '-':
		i++
		r.neg = true
	}

	// digits
	base := 10
	maxMantDigits := 18 // 10^18 fits in int
	var expChar byte = 'e'
	if i+2 < len(s) && s[i] == '0' && lower(s[i+1]) == 'x' {
		base = 16
		maxMantDigits = 15 // 16^15 fits in int
		i += 2
		expChar = 'p'
		r.hex = true
	}
	sawdot := false
	sawdigits := false
	nd := 0
	ndMant := 0
	dp := 0
	for ; i < len(s); i++ {
		c := s[i]
		if c == '_' {
			underscores = true
			continue
		}
		if c == '.' {
			if sawdot {
				break
			}
			sawdot = true
			dp = nd
			continue
		}
		if '0' <= c && c <= '9' {
			sawdigits = true
			if c == '0' && nd == 0 { // ignore leading zeros
				dp--
				continue
			}
			nd++
			if ndMant < maxMantDigits {
				r.mantissa = r.mantissa*base + int(c-'0')
				ndMant++
			} else if c != '0' {
				r.trunc = true
			}
			continue
		}
		if base == 16 && 'a' <= lower(c) && lower(c) <= 'f' {
			sawdigits = true
			nd++
			if ndMant < maxMantDigits {
				r.mantissa = r.mantissa*16 + int(lower(c)-'a') + 10
				ndMant++
			} else {
				r.trunc = true
			}
			continue
		}
		break
	}
	if !sawdigits {
		r.n = i
		return r
	}
	if !sawdot {
		dp = nd
	}

	if base == 16 {
		dp *= 4
		ndMant *= 4
	}

	// optional exponent moves decimal point. If we read a very large, very long number, just be
	// sure to move the decimal point by a lot (say, 100000). It doesn't matter if it's not the
	// exact number.
	if i < len(s) && lower(s[i]) == expChar {
		i++
		if i >= len(s) {
			r.n = i
			return r
		}
		esign := 1
		switch s[i] {
		case '+':
			i++
		case '-':
			i++
			esign = -1
		}
		if i >= len(s) || s[i] < '0' || s[i] > '9' {
			r.n = i
			return r
		}
		e := 0
		for ; i < len(s) && ('0' <= s[i] && s[i] <= '9' || s[i] == '_'); i++ {
			if s[i] == '_' {
				underscores = true
				continue
			}
			if e < 10000 {
				e = e*10 + int(s[i]-'0')
			}
		}
		dp += e * esign
	} else if base == 16 {
		// Must have exponent.
		r.n = i
		return r
	}

	if r.mantissa != 0 {
		r.exp = dp - ndMant
	}

	r.n = i
	if underscores && !underscoreOK(s[:i]) {
		return r
	}
	r.ok = true
	return r
}

// floatBits converts the decimal d to the nearest float64, reporting overflow (Go's floatBits).
func (d *decimal) floatBits() (float64, bool) {
	exp := 0
	mant := 0
	overflow := false

	if d.nd == 0 {
		// Zero is always a special case.
		return signed(0, d.neg), false
	}

	// Obvious overflow/underflow. These bounds are for 64-bit floats. Will have to change if we
	// want to support 80-bit floats in the future.
	if d.dp > 310 {
		return signed(math.Inf(1), d.neg), true
	}
	if d.dp < -330 {
		// zero
		return signed(0, d.neg), false
	}

	// Scale by powers of two until in range [0.5, 1.0)
	powtab := [9]int{1, 3, 6, 9, 13, 16, 19, 23, 26}
	for d.dp > 0 {
		n := 27
		if d.dp < len(powtab) {
			n = powtab[d.dp]
		}
		d.shift(-n)
		exp += n
	}
	for d.dp < 0 || d.dp == 0 && d.d[0] < '5' {
		n := 27
		if -d.dp < len(powtab) {
			n = powtab[-d.dp]
		}
		d.shift(n)
		exp -= n
	}

	// Our range is [0.5,1) but floating point range is [1,2).
	exp--

	// Minimum representable exponent is bias+1. If the exponent is smaller, move it up and adjust
	// d accordingly.
	if exp < bias+1 {
		n := bias + 1 - exp
		d.shift(-n)
		exp += n
	}

	if exp-bias >= 1<<expBits-1 {
		return signed(math.Inf(1), d.neg), true
	}

	// Extract 1+mantBits bits.
	d.shift(1 + mantBits)
	mant = d.roundedInteger()

	// Rounding might have added a bit; shift down.
	if mant == 2<<mantBits {
		mant >>= 1
		exp++
		if exp-bias >= 1<<expBits-1 {
			return signed(math.Inf(1), d.neg), true
		}
	}

	// Denormalized?
	if mant&(1<<mantBits) == 0 {
		exp = bias
	}

	b := mant&(1<<mantBits-1) | ((exp-bias)&(1<<expBits-1))<<mantBits
	return signed(math.Float64frombits(b), d.neg), overflow
}

// signed returns f, negated if neg.
func signed(f float64, neg bool) float64 {
	if neg {
		return -f
	}
	return f
}

// atofHex converts the hexadecimal mantissa * 2^exp to the nearest float64, rounding once
// (Go's atofHex). trunc reports nonzero bits beyond the mantissa.
func atofHex(mantissa int, exp int, neg, trunc bool) (float64, string) {
	maxExp := 1<<expBits + bias - 2
	minExp := bias + 1
	exp += mantBits // mantissa now implicitly divided by 2^mantBits.

	// Shift mantissa and exponent to bring representation into float range. Eventually we want a
	// mantissa with a leading 1-bit followed by mantBits other bits. For rounding, we need two
	// more, where the bottom bit represents whether that bit or any later bit was non-zero. (If
	// the mantissa has already lost non-zero bits, trunc is true, and we OR in a 1 below after
	// shifting left appropriately.)
	for mantissa != 0 && mantissa>>(mantBits+2) == 0 {
		mantissa <<= 1
		exp--
	}
	if trunc {
		mantissa |= 1
	}
	for mantissa>>(1+mantBits+2) != 0 {
		mantissa = mantissa>>1 | mantissa&1
		exp++
	}

	// If exponent is too negative, denormalize in hopes of making it representable. (The -2 is
	// for the rounding bits.)
	for mantissa > 1 && exp < minExp-2 {
		mantissa = mantissa>>1 | mantissa&1
		exp++
	}

	// Round using two bottom bits.
	round := mantissa & 3
	mantissa >>= 2
	round |= mantissa & 1 // round to even (round up if mantissa is odd)
	exp += 2
	if round == 3 {
		mantissa++
		if mantissa == 1<<(1+mantBits) {
			mantissa >>= 1
			exp++
		}
	}

	if mantissa>>mantBits == 0 { // Denormal or zero.
		exp = bias
	}
	msg := ""
	if exp > maxExp { // infinity and range error
		mantissa = 1 << mantBits
		exp = maxExp + 1
		msg = "value out of range"
	}

	b := mantissa&(1<<mantBits-1) | ((exp-bias)&(1<<expBits-1))<<mantBits
	return signed(math.Float64frombits(b), neg), msg
}

// atof64 parses a float64 prefix of s: the value, the bytes read, and an error message.
func atof64(s string) (float64, int, string) {
	val, n, ok := special(s)
	if ok {
		return val, n, ""
	}

	r := readFloat(s)
	if !r.ok {
		return 0, r.n, "invalid syntax"
	}

	if r.hex {
		f, msg := atofHex(r.mantissa, r.exp, r.neg, r.trunc)
		return f, r.n, msg
	}

	d := &decimal{}
	if !d.set(s[:r.n]) {
		return 0, r.n, "invalid syntax"
	}
	f, ovf := d.floatBits()
	if ovf {
		return f, r.n, "value out of range"
	}
	return f, r.n, ""
}
