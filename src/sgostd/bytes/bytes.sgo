// Package bytes manipulates byte slices (SGO-STD-003), as Go's bytes package does for the
// functions it shares with it. Results that are slices of an argument share its array, as in Go;
// slices are task-local (SGO-COMP-004).
package bytes

import "std/utf8"

// Equal reports whether a and b hold the same bytes; nil and empty are equal.
func Equal(a, b []byte) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// Compare returns 0 if a == b, -1 if a < b, and +1 if a > b, comparing bytes lexicographically.
func Compare(a, b []byte) int {
	n := len(a)
	if len(b) < n {
		n = len(b)
	}
	for i := 0; i < n; i++ {
		if a[i] != b[i] {
			if a[i] < b[i] {
				return -1
			}
			return 1
		}
	}
	switch {
	case len(a) < len(b):
		return -1
	case len(a) > len(b):
		return 1
	}
	return 0
}

// at reports whether sep occurs in s at offset i.
func at(s []byte, i int, sep []byte) bool {
	if i+len(sep) > len(s) {
		return false
	}
	for j := 0; j < len(sep); j++ {
		if s[i+j] != sep[j] {
			return false
		}
	}
	return true
}

// Index returns the index of the first instance of sep in s, or -1.
func Index(s, sep []byte) int {
	for i := 0; i+len(sep) <= len(s); i++ {
		if at(s, i, sep) {
			return i
		}
	}
	return -1
}

// LastIndex returns the index of the last instance of sep in s, or -1.
func LastIndex(s, sep []byte) int {
	for i := len(s) - len(sep); i >= 0; i-- {
		if at(s, i, sep) {
			return i
		}
	}
	return -1
}

// IndexByte returns the index of the first instance of c in b, or -1.
func IndexByte(b []byte, c byte) int {
	for i := 0; i < len(b); i++ {
		if b[i] == c {
			return i
		}
	}
	return -1
}

// Contains reports whether subslice is within b.
func Contains(b, subslice []byte) bool {
	return Index(b, subslice) >= 0
}

// Count returns the number of non-overlapping instances of sep in s; if sep is empty, the number
// of UTF-8 sequences in s plus one.
func Count(s, sep []byte) int {
	if len(sep) == 0 {
		return utf8.RuneCount(s) + 1
	}
	n := 0
	for i := 0; i+len(sep) <= len(s); {
		if at(s, i, sep) {
			n++
			i += len(sep)
		} else {
			i++
		}
	}
	return n
}

// HasPrefix reports whether s begins with prefix.
func HasPrefix(s, prefix []byte) bool {
	return at(s, 0, prefix)
}

// HasSuffix reports whether s ends with suffix.
func HasSuffix(s, suffix []byte) bool {
	return len(s) >= len(suffix) && at(s, len(s)-len(suffix), suffix)
}

// Join concatenates the elements of s with sep between them into a new slice (an empty s gives an
// empty, non-nil slice; a single empty element gives nil, as in Go).
func Join(s [][]byte, sep []byte) []byte {
	if len(s) == 0 {
		return []byte{}
	}
	if len(s) == 1 {
		var r []byte = nil
		return append(r, s[0]...)
	}
	n := len(sep) * (len(s) - 1)
	for _, v := range s {
		n += len(v)
	}
	b := make([]byte, 0, n)
	b = append(b, s[0]...)
	for _, v := range s[1:] {
		b = append(b, sep...)
		b = append(b, v...)
	}
	return b
}

// Split slices s into all subslices separated by sep; each piece shares s's array and has its own
// length as capacity. An empty sep splits after each UTF-8 sequence.
func Split(s, sep []byte) [][]byte {
	if len(sep) == 0 {
		// As Go's explode: the outer slice is sized by bytes, one piece per UTF-8 sequence.
		n := len(s)
		a := make([][]byte, n)
		na := 0
		for len(s) > 0 {
			if na+1 >= n {
				a[na] = s
				na++
				break
			}
			_, size := utf8.DecodeRune(s)
			a[na] = s[0:size:size]
			s = s[size:]
			na++
		}
		return a[0:na]
	}
	n := Count(s, sep) + 1
	if n > len(s)+1 {
		n = len(s) + 1
	}
	a := make([][]byte, n)
	n--
	i := 0
	for i < n {
		m := Index(s, sep)
		if m < 0 {
			break
		}
		a[i] = s[0:m:m]
		s = s[m+len(sep):]
		i++
	}
	a[i] = s
	return a[:i+1]
}

// isSpace reports whether r has Unicode's White_Space property.
func isSpace(r rune) bool {
	switch r {
	case 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x20, 0x85, 0xA0, 0x1680, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000:
		return true
	}
	return 0x2000 <= r && r <= 0x200A
}

// TrimSpace returns the subslice of s without leading and trailing white space (Unicode
// White_Space), or nil if nothing remains.
func TrimSpace(s []byte) []byte {
	lo := 0
	for lo < len(s) {
		r, n := utf8.DecodeRune(s[lo:])
		if !isSpace(r) {
			break
		}
		lo += n
	}
	if lo == len(s) {
		return nil
	}
	hi := len(s)
	for hi > lo {
		r, n := utf8.DecodeLastRune(s[lo:hi])
		if !isSpace(r) {
			break
		}
		hi -= n
	}
	return s[lo:hi]
}

// Clone returns a copy of b in a new array; Clone(nil) is nil.
func Clone(b []byte) []byte {
	if b == nil {
		return nil
	}
	return append([]byte{}, b...)
}
