package tls

const (
	typeClientHello         = 1
	typeServerHello         = 2
	typeNewSessionTicket    = 4
	typeEncryptedExtensions = 8
	typeCertificate         = 11
	typeCertificateRequest  = 13
	typeCertificateVerify   = 15
	typeFinished            = 20
	typeKeyUpdate           = 24

	extServerName          = 0
	extSupportedGroups     = 10
	extSignatureAlgorithms = 13
	extALPN                = 16
	extSupportedVersions   = 43
	extCookie              = 44
	extKeyShare            = 51

	groupX25519 = 0x001d
	versionTLS13 = 0x0304
)

// The signature schemes the client offers, in Go's order of preference for TLS 1.3.
func offeredSchemes() []int {
	return []int{0x0403, 0x0804, 0x0807, 0x0503, 0x0603, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601}
}

// helloRetryRandom marks a ServerHello as a HelloRetryRequest (RFC 8446 section 4.1.3).
const helloRetryRandom = "\xcf\x21\xad\x74\xe5\x9a\x61\x11\xbe\x1d\x8c\x02\x1e\x65\xb8\x91\xc2\xa2\x11\x16\x7a\xbb\x8c\x5e\x07\x9e\x09\xe2\xc8\xa8\x33\x9c"

func u8(b []byte, v int) []byte {
	return append(b, byte(v&0xff))
}
func u16(b []byte, v int) []byte { return append(b, byte((v>>8)&0xff), byte(v&0xff)) }
func u24(b []byte, v int) []byte { return append(b, byte((v>>16)&0xff), byte((v>>8)&0xff), byte(v&0xff)) }

func vec8(b, body []byte) []byte  { return append(u8(b, len(body)), body...) }
func vec16(b, body []byte) []byte { return append(u16(b, len(body)), body...) }
func vec24(b, body []byte) []byte { return append(u24(b, len(body)), body...) }

func extension(b []byte, typ int, body []byte) []byte {
	return vec16(u16(b, typ), body)
}

// handshakeMessage frames a handshake message body with its type and length.
func handshakeMessage(typ int, body []byte) []byte {
	return vec24(u8([]byte{}, typ), body)
}

// A reader reads big-endian integers and length-prefixed vectors; any short read marks it
// failed and later reads return zero.
type reader struct {
	b  []byte
	ok bool
}

func newReader(b []byte) *reader { return &reader{b: b, ok: true} }

func (r *reader) take(n int) []byte {
	if !r.ok || n < 0 || len(r.b) < n {
		r.ok = false
		return []byte{}
	}
	out := r.b[:n]
	r.b = r.b[n:]
	return out
}

func (r *reader) u8() int {
	b := r.take(1)
	if len(b) < 1 {
		return 0
	}
	return int(b[0])
}

func (r *reader) u16() int {
	b := r.take(2)
	if len(b) < 2 {
		return 0
	}
	return int(b[0])<<8 | int(b[1])
}

func (r *reader) u24() int {
	b := r.take(3)
	if len(b) < 3 {
		return 0
	}
	return int(b[0])<<16 | int(b[1])<<8 | int(b[2])
}

func (r *reader) vec8() []byte  { return r.take(r.u8()) }
func (r *reader) vec16() []byte { return r.take(r.u16()) }
func (r *reader) vec24() []byte { return r.take(r.u24()) }
func (r *reader) empty() bool   { return r.ok && len(r.b) == 0 }

type clientHello struct {
	random     []byte
	sessionID  []byte
	serverName string
	keyShare   []byte
	alpn       []string
	cookie     []byte
	suites     []int
}

func (h clientHello) marshal() []byte {
	b := u16([]byte{}, 0x0303)
	b = append(b, h.random...)
	b = vec8(b, h.sessionID)
	cs := []byte{}
	for i := 0; i < len(h.suites); i++ {
		cs = u16(cs, h.suites[i])
	}
	b = vec16(b, cs)
	b = vec8(b, []byte{0})
	ext := []byte{}
	if h.serverName != "" {
		name := vec16(u8([]byte{}, 0), []byte(h.serverName))
		ext = extension(ext, extServerName, vec16([]byte{}, name))
	}
	ext = extension(ext, extSupportedGroups, vec16([]byte{}, u16([]byte{}, groupX25519)))
	sch := []byte{}
	o := offeredSchemes()
	for i := 0; i < len(o); i++ {
		sch = u16(sch, o[i])
	}
	ext = extension(ext, extSignatureAlgorithms, vec16([]byte{}, sch))
	if len(h.alpn) > 0 {
		p := []byte{}
		for i := 0; i < len(h.alpn); i++ {
			p = vec8(p, []byte(h.alpn[i]))
		}
		ext = extension(ext, extALPN, vec16([]byte{}, p))
	}
	ext = extension(ext, extSupportedVersions, vec8([]byte{}, u16([]byte{}, versionTLS13)))
	if len(h.cookie) > 0 {
		ext = extension(ext, extCookie, vec16([]byte{}, h.cookie))
	}
	ks := vec16(u16([]byte{}, groupX25519), h.keyShare)
	ext = extension(ext, extKeyShare, vec16([]byte{}, ks))
	b = vec16(b, ext)
	return handshakeMessage(typeClientHello, b)
}

type serverHello struct {
	random       []byte
	sessionID    []byte
	suite        int
	version      int
	keyShareGrp  int
	keyShare     []byte
	selectedGrp  int
	hasSelGrp    bool
	cookie       []byte
	hasKeyShare  bool
	hasVersion   bool
	legacy       int
	compression  int
}

func parseServerHello(body []byte) (serverHello, bool) {
	r := newReader(body)
	h := serverHello{random: []byte{}, sessionID: []byte{}, suite: 0, version: 0, keyShareGrp: 0, keyShare: []byte{}, selectedGrp: 0, hasSelGrp: false, cookie: []byte{}, hasKeyShare: false, hasVersion: false, legacy: 0, compression: 0}
	h.legacy = r.u16()
	h.random = r.take(32)
	h.sessionID = r.vec8()
	h.suite = r.u16()
	h.compression = r.u8()
	ext := newReader(r.vec16())
	if !r.empty() {
		return h, false
	}
	isHRR := string(h.random) == helloRetryRandom
	seen := map[int]bool{}
	for ext.ok && len(ext.b) > 0 {
		typ := ext.u16()
		data := newReader(ext.vec16())
		if seen[typ] {
			return h, false
		}
		seen[typ] = true
		if typ == extSupportedVersions {
			h.version = data.u16()
			h.hasVersion = true
		} else if typ == extKeyShare {
			if isHRR {
				h.selectedGrp = data.u16()
				h.hasSelGrp = true
			} else {
				h.keyShareGrp = data.u16()
				h.keyShare = data.vec16()
				h.hasKeyShare = true
			}
		} else if typ == extCookie {
			h.cookie = data.vec16()
			if len(h.cookie) == 0 {
				return h, false
			}
		} else {
			continue
		}
		if !data.empty() {
			return h, false
		}
	}
	return h, ext.ok
}

// parseEncryptedExtensions returns the ALPN protocol the server selected, if any.
func parseEncryptedExtensions(body []byte) (string, bool) {
	r := newReader(body)
	ext := newReader(r.vec16())
	if !r.empty() {
		return "", false
	}
	proto := ""
	for ext.ok && len(ext.b) > 0 {
		typ := ext.u16()
		data := newReader(ext.vec16())
		if typ == extALPN {
			list := newReader(data.vec16())
			proto = string(list.vec8())
			if !list.empty() || !data.empty() || proto == "" {
				return "", false
			}
		}
	}
	return proto, ext.ok
}

// parseCertificate returns the certificate_list's DER certificates (RFC 8446 section 4.4.2).
func parseCertificate(body []byte) ([][]byte, bool) {
	r := newReader(body)
	ctx := r.vec8()
	list := newReader(r.vec24())
	if !r.empty() || len(ctx) != 0 {
		return [][]byte{}, false
	}
	out := [][]byte{}
	for list.ok && len(list.b) > 0 {
		der := list.vec24()
		_ = list.vec16()
		if len(der) == 0 {
			return [][]byte{}, false
		}
		out = append(out, der)
	}
	return out, list.ok
}

func parseCertificateVerify(body []byte) (int, []byte, bool) {
	r := newReader(body)
	scheme := r.u16()
	sig := r.vec16()
	return scheme, sig, r.empty()
}
