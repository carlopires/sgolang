// Package sha512 implements the SHA-384, SHA-512, SHA-512/224, and SHA-512/256 hash functions of
// FIPS 180-4 (SGO-STD-016, D197), with the results of Go's crypto/sha512. The round constants
// and initial values are package-level tables (D136); sums modulo 2^64 are written with
// std/bits. The computation has no branch or table index that depends on the data hashed.
package sha512

import (
	"sgo"
	"std/bits"
	"std/encoding/binary"
	"std/hash"
)

// Checksum sizes and the block size, in bytes.
const (
	Size      = 64
	Size224   = 28
	Size256   = 32
	Size384   = 48
	BlockSize = 128
)

var roundK = sgo.Freeze([]uint64{
	0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
	0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
	0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
	0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
	0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
	0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
	0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
	0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
	0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
	0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
	0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
	0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
	0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
	0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
	0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
	0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
	0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
	0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
	0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
	0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
})

var init512 = sgo.Freeze([]uint64{
	0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
	0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
})

var init384 = sgo.Freeze([]uint64{
	0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
	0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4,
})

var init224 = sgo.Freeze([]uint64{
	0x8c3d37c819544da2, 0x73e1996689dcd4d6, 0x1dfab7ae32ff9c82, 0x679dd514582f9fcf,
	0x0f6d2b697bd44da8, 0x77e36f7304c48942, 0x3f9d85a86a1d36c8, 0x1112e6ad91d692a1,
})

var init256 = sgo.Freeze([]uint64{
	0x22312194fc2bf72c, 0x9f555fa3c84c64c2, 0x2393b86b6f53b151, 0x963877195940eabd,
	0x96283ee2a88effe3, 0xbe5e1e2553863992, 0x2b0199fc2c85b8aa, 0x0eb72ddc81c52ca2,
})

// A digest is a running SHA-512-family computation.
type digest struct {
	h    [8]uint64
	x    [BlockSize]byte
	nx   int
	len  int
	size int
}

func newDigest(size int) *digest {
	d := &digest{size: size}
	d.Reset()
	return d
}

// New returns a SHA-512 hash.
func New() hash.Hash {
	return newDigest(Size)
}

// New384 returns a SHA-384 hash.
func New384() hash.Hash {
	return newDigest(Size384)
}

// New512_224 returns a SHA-512/224 hash.
func New512_224() hash.Hash {
	return newDigest(Size224)
}

// New512_256 returns a SHA-512/256 hash.
func New512_256() hash.Hash {
	return newDigest(Size256)
}

// Reset returns d to its initial state.
func (d *digest) Reset() {
	for i := 0; i < 8; i++ {
		switch d.size {
		case Size384:
			d.h[i] = init384.Get()[i]
		case Size224:
			d.h[i] = init224.Get()[i]
		case Size256:
			d.h[i] = init256.Get()[i]
		default:
			d.h[i] = init512.Get()[i]
		}
	}
	d.nx = 0
	d.len = 0
}

// Size returns the checksum length in bytes.
func (d *digest) Size() int {
	return d.size
}

// BlockSize returns the block size, 128.
func (d *digest) BlockSize() int {
	return BlockSize
}

// Write adds p to the running hash. It never fails.
func (d *digest) Write(p []byte) (int, error) {
	n := len(p)
	d.len = d.len + n
	i := 0
	if d.nx > 0 {
		for i < n && d.nx < BlockSize {
			d.x[d.nx] = p[i]
			d.nx++
			i++
		}
		if d.nx == BlockSize {
			block(&d.h, d.x[:])
			d.nx = 0
		}
	}
	for n-i >= BlockSize {
		block(&d.h, p[i:i+BlockSize])
		i = i + BlockSize
	}
	for i < n {
		d.x[d.nx] = p[i]
		d.nx++
		i++
	}
	return n, nil
}

// Sum appends the checksum of the data written so far to b; d is unchanged.
func (d *digest) Sum(b []byte) []byte {
	c := *d
	sum := c.finish()
	return append(b, sum[:c.size]...)
}

// finish pads with 0x80, zeros, and the 128-bit length in bits, and returns the state as bytes.
func (d *digest) finish() [Size]byte {
	n := d.len
	pad := [BlockSize + 16]byte{}
	pad[0] = 0x80
	k := 111 - n%128
	if k < 0 {
		k = k + 128
	}
	bitLen := uint64(n) << 3
	binary.BigEndian.PutUint64(pad[9+k:17+k], bitLen)
	_, _ = d.Write(pad[:17+k])
	out := [Size]byte{}
	for i := 0; i < 8; i++ {
		binary.BigEndian.PutUint64(out[8*i:8*i+8], d.h[i])
	}
	return out
}

// Sum512 returns the SHA-512 checksum of data.
func Sum512(data []byte) [Size]byte {
	d := newDigest(Size)
	_, _ = d.Write(data)
	return d.finish()
}

// Sum384 returns the SHA-384 checksum of data.
func Sum384(data []byte) [Size384]byte {
	d := newDigest(Size384)
	_, _ = d.Write(data)
	full := d.finish()
	out := [Size384]byte{}
	for i := 0; i < Size384; i++ {
		out[i] = full[i]
	}
	return out
}

// Sum512_224 returns the SHA-512/224 checksum of data.
func Sum512_224(data []byte) [Size224]byte {
	d := newDigest(Size224)
	_, _ = d.Write(data)
	full := d.finish()
	out := [Size224]byte{}
	for i := 0; i < Size224; i++ {
		out[i] = full[i]
	}
	return out
}

// Sum512_256 returns the SHA-512/256 checksum of data.
func Sum512_256(data []byte) [Size256]byte {
	d := newDigest(Size256)
	_, _ = d.Write(data)
	full := d.finish()
	out := [Size256]byte{}
	for i := 0; i < Size256; i++ {
		out[i] = full[i]
	}
	return out
}

// add is a + b modulo 2^64.
func add(a, b uint64) uint64 {
	s, _ := bits.Add64(a, b, 0)
	return s
}

// block processes one 128-byte block p into the state h.
func block(h *[8]uint64, p []byte) {
	w := [80]uint64{}
	for i := 0; i < 16; i++ {
		w[i] = binary.BigEndian.Uint64(p[8*i : 8*i+8])
	}
	for i := 16; i < 80; i++ {
		v1 := w[i-2]
		t1 := bits.RotateLeft64(v1, -19) ^ bits.RotateLeft64(v1, -61) ^ (v1 >> 6)
		v2 := w[i-15]
		t2 := bits.RotateLeft64(v2, -1) ^ bits.RotateLeft64(v2, -8) ^ (v2 >> 7)
		w[i] = add(add(t1, w[i-7]), add(t2, w[i-16]))
	}
	a, b, c, dd, e, f, g, hh := h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]
	for i := 0; i < 80; i++ {
		s1 := bits.RotateLeft64(e, -14) ^ bits.RotateLeft64(e, -18) ^ bits.RotateLeft64(e, -41)
		ch := (e & f) ^ (^e & g)
		t1 := add(add(add(hh, s1), add(ch, roundK.Get()[i])), w[i])
		s0 := bits.RotateLeft64(a, -28) ^ bits.RotateLeft64(a, -34) ^ bits.RotateLeft64(a, -39)
		maj := (a & b) ^ (a & c) ^ (b & c)
		t2 := add(s0, maj)
		hh = g
		g = f
		f = e
		e = add(dd, t1)
		dd = c
		c = b
		b = a
		a = add(t1, t2)
	}
	h[0] = add(h[0], a)
	h[1] = add(h[1], b)
	h[2] = add(h[2], c)
	h[3] = add(h[3], dd)
	h[4] = add(h[4], e)
	h[5] = add(h[5], f)
	h[6] = add(h[6], g)
	h[7] = add(h[7], hh)
}
