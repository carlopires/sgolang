package ed25519

import (
	"sgo"
	"std/encoding/hex"
)

func unhex(s string) []byte {
	b, _ := hex.DecodeString(s)
	return b
}

// RFC 8032 section 7.1, tests 1 and 2.
func TestRFC8032(t *sgo.T) error {
	p1 := NewKeyFromSeed(unhex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"))
	if hex.EncodeToString(Public(p1)) != "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a" {
		return sgo.NewError("test 1 public key")
	}
	if hex.EncodeToString(Sign(p1, []byte{})) != "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b" {
		return sgo.NewError("test 1 signature")
	}
	p2 := NewKeyFromSeed(unhex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"))
	if hex.EncodeToString(Public(p2)) != "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c" {
		return sgo.NewError("test 2 public key")
	}
	if hex.EncodeToString(Sign(p2, []byte{0x72})) != "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00" {
		return sgo.NewError("test 2 signature")
	}
	return nil
}

// A signature verifies; a changed message, a flipped bit, or S + L does not.
func TestVerify(t *sgo.T) error {
	priv := NewKeyFromSeed(unhex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"))
	pub := Public(priv)
	sig := Sign(priv, []byte("message"))
	if !Verify(pub, []byte("message"), sig) {
		return sgo.NewError("valid signature refused")
	}
	if Verify(pub, []byte("messagf"), sig) {
		return sgo.NewError("changed message accepted")
	}
	bad := make([]byte, len(sig))
	copy(bad, sig)
	bad[5] = bad[5] ^ 1
	if Verify(pub, []byte("message"), bad) {
		return sgo.NewError("flipped bit accepted")
	}
	// S + L has the same value mod L; Go refuses it as non-canonical.
	l := orderL()
	c := 0
	for i := 0; i < 32; i++ {
		v := int(sig[32+i]) + l[i] + c
		bad[32+i] = byte(v & 255)
		c = v >> 8
	}
	copy(bad[:32], sig[:32])
	if Verify(pub, []byte("message"), bad) {
		return sgo.NewError("non-canonical S accepted")
	}
	if Verify(pub, []byte("message"), sig[:63]) {
		return sgo.NewError("short signature accepted")
	}
	return nil
}
