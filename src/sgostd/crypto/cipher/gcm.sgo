package cipher

import (
	"std/bits"
	"std/encoding/binary"
	"std/errors"
)

const (
	gcmBlockSize = 16
	gcmNonceSize = 12
	gcmTagSize   = 16
)

type gcm struct {
	b  Block
	h0 uint64
	h1 uint64
}

// NewGCM returns the Galois/Counter Mode AEAD of NIST SP 800-38D over a 16-byte block cipher,
// with a 12-byte nonce and a 16-byte tag, as Go's crypto/cipher NewGCM. GHASH uses no branch and
// no table index that depends on the key or the data.
func NewGCM(b Block) (AEAD, error) {
	if b.BlockSize() != gcmBlockSize {
		return nil, errors.New("cipher: NewGCM requires 128-bit block cipher")
	}
	h := make([]byte, gcmBlockSize)
	b.Encrypt(h, h)
	return &gcm{b: b, h1: binary.BigEndian.Uint64(h[0:8]), h0: binary.BigEndian.Uint64(h[8:16])}, nil
}

func (g *gcm) NonceSize() int {
	return gcmNonceSize
}

func (g *gcm) Overhead() int {
	return gcmTagSize
}

func lo64(x, y uint64) uint64 {
	_, l := bits.Mul64(x, y)
	return l
}

// bmul64 is the carry-less product of x and y modulo 2^64 (BearSSL's ghash_ctmul64).
func bmul64(x, y uint64) uint64 {
	const m0 uint64 = 0x1111111111111111
	const m1 uint64 = 0x2222222222222222
	const m2 uint64 = 0x4444444444444444
	const m3 uint64 = 0x8888888888888888
	x0, x1, x2, x3 := x&m0, x&m1, x&m2, x&m3
	y0, y1, y2, y3 := y&m0, y&m1, y&m2, y&m3
	z0 := lo64(x0, y0) ^ lo64(x1, y3) ^ lo64(x2, y2) ^ lo64(x3, y1)
	z1 := lo64(x0, y1) ^ lo64(x1, y0) ^ lo64(x2, y3) ^ lo64(x3, y2)
	z2 := lo64(x0, y2) ^ lo64(x1, y1) ^ lo64(x2, y0) ^ lo64(x3, y3)
	z3 := lo64(x0, y3) ^ lo64(x1, y2) ^ lo64(x2, y1) ^ lo64(x3, y0)
	return (z0 & m0) | (z1 & m1) | (z2 & m2) | (z3 & m3)
}

func rev64(x uint64) uint64 {
	x = ((x >> 1) & 0x5555555555555555) | ((x & 0x5555555555555555) << 1)
	x = ((x >> 2) & 0x3333333333333333) | ((x & 0x3333333333333333) << 2)
	x = ((x >> 4) & 0x0f0f0f0f0f0f0f0f) | ((x & 0x0f0f0f0f0f0f0f0f) << 4)
	return bits.ReverseBytes64(x)
}

const all64 uint64 = 0xffffffffffffffff

// shl is x << n with the bits shifted out dropped.
func shl(x uint64, n int) uint64 {
	return (x & (all64 >> n)) << n
}

// ghash folds data, padded with zeros to whole blocks, into the accumulator y1:y0.
func (g *gcm) ghash(y1, y0 uint64, data []byte) (uint64, uint64) {
	h0, h1 := g.h0, g.h1
	h0r, h1r := rev64(h0), rev64(h1)
	h2, h2r := h0^h1, h0r^h1r
	for off := 0; off < len(data); off += gcmBlockSize {
		blk := make([]byte, gcmBlockSize)
		copy(blk, data[off:])
		y1 = y1 ^ binary.BigEndian.Uint64(blk[0:8])
		y0 = y0 ^ binary.BigEndian.Uint64(blk[8:16])
		y0r, y1r := rev64(y0), rev64(y1)
		y2, y2r := y0^y1, y0r^y1r
		z0 := bmul64(y0, h0)
		z1 := bmul64(y1, h1)
		z2 := bmul64(y2, h2)
		z0h := bmul64(y0r, h0r)
		z1h := bmul64(y1r, h1r)
		z2h := bmul64(y2r, h2r)
		z2 = z2 ^ z0 ^ z1
		z2h = z2h ^ z0h ^ z1h
		z0h = rev64(z0h) >> 1
		z1h = rev64(z1h) >> 1
		z2h = rev64(z2h) >> 1
		v0 := z0
		v1 := z0h ^ z2
		v2 := z1 ^ z2h
		v3 := z1h
		v3 = shl(v3, 1) | (v2 >> 63)
		v2 = shl(v2, 1) | (v1 >> 63)
		v1 = shl(v1, 1) | (v0 >> 63)
		v0 = shl(v0, 1)
		v2 = v2 ^ v0 ^ (v0 >> 1) ^ (v0 >> 2) ^ (v0 >> 7)
		v1 = v1 ^ shl(v0, 63) ^ shl(v0, 62) ^ shl(v0, 57)
		v3 = v3 ^ v1 ^ (v1 >> 1) ^ (v1 >> 2) ^ (v1 >> 7)
		v2 = v2 ^ shl(v1, 63) ^ shl(v1, 62) ^ shl(v1, 57)
		y0 = v2
		y1 = v3
	}
	return y1, y0
}

// counter returns the counter block J0 + n with the low 32 bits wrapping.
func counter(nonce []byte, n uint32) []byte {
	c := make([]byte, gcmBlockSize)
	copy(c, nonce)
	binary.BigEndian.PutUint32(c[12:16], n)
	return c
}

func (g *gcm) ctr(dst, src, nonce []byte) {
	ks := make([]byte, gcmBlockSize)
	var n uint32 = 2
	for off := 0; off < len(src); off += gcmBlockSize {
		g.b.Encrypt(ks, counter(nonce, n))
		for i := 0; i < gcmBlockSize && off+i < len(src); i++ {
			dst[off+i] = src[off+i] ^ ks[i]
		}
		s, _ := bits.Add32(n, 1, 0)
		n = s
	}
}

func (g *gcm) tag(out, nonce, ciphertext, additionalData []byte) {
	y1, y0 := g.ghash(0, 0, additionalData)
	y1, y0 = g.ghash(y1, y0, ciphertext)
	lens := make([]byte, gcmBlockSize)
	binary.BigEndian.PutUint64(lens[0:8], uint64(len(additionalData))*8)
	binary.BigEndian.PutUint64(lens[8:16], uint64(len(ciphertext))*8)
	y1, y0 = g.ghash(y1, y0, lens)
	s := make([]byte, gcmBlockSize)
	binary.BigEndian.PutUint64(s[0:8], y1)
	binary.BigEndian.PutUint64(s[8:16], y0)
	ek := make([]byte, gcmBlockSize)
	g.b.Encrypt(ek, counter(nonce, 1))
	for i := 0; i < gcmTagSize; i++ {
		out[i] = s[i] ^ ek[i]
	}
}

// Seal encrypts and authenticates plaintext with additionalData and appends the result to dst.
// A nonce of the wrong length fails as Go's panic.
func (g *gcm) Seal(dst, nonce, plaintext, additionalData []byte) []byte {
	if len(nonce) != gcmNonceSize {
		panic("crypto/cipher: incorrect nonce length given to GCM")
	}
	n := len(dst)
	out := append(dst, make([]byte, len(plaintext)+gcmTagSize)...)
	ct := out[n : n+len(plaintext)]
	g.ctr(ct, plaintext, nonce)
	g.tag(out[n+len(plaintext):], nonce, ct, additionalData)
	return out
}

// Open authenticates and decrypts ciphertext and appends the plaintext to dst; an inauthentic
// message is the error "cipher: message authentication failed".
func (g *gcm) Open(dst, nonce, ciphertext, additionalData []byte) ([]byte, error) {
	if len(nonce) != gcmNonceSize {
		panic("crypto/cipher: incorrect nonce length given to GCM")
	}
	if len(ciphertext) < gcmTagSize {
		return []byte{}, errors.New("cipher: message authentication failed")
	}
	ct := ciphertext[:len(ciphertext)-gcmTagSize]
	want := make([]byte, gcmTagSize)
	g.tag(want, nonce, ct, additionalData)
	given := ciphertext[len(ct):]
	var v byte = 0
	for i := 0; i < gcmTagSize; i++ {
		v = v | (want[i] ^ given[i])
	}
	if v != 0 {
		return []byte{}, errors.New("cipher: message authentication failed")
	}
	n := len(dst)
	out := append(dst, make([]byte, len(ct))...)
	g.ctr(out[n:], ct, nonce)
	return out, nil
}
