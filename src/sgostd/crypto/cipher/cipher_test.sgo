package cipher

import "sgo"

type nullAEAD struct {
	n int
}

func (a *nullAEAD) NonceSize() int {
	return a.n
}

func (a *nullAEAD) Overhead() int {
	return 0
}

func (a *nullAEAD) Seal(dst, nonce, plaintext, additionalData []byte) []byte {
	return append(dst, plaintext...)
}

func (a *nullAEAD) Open(dst, nonce, ciphertext, additionalData []byte) ([]byte, error) {
	return append(dst, ciphertext...), nil
}

// A user type with the four methods is an AEAD.
func TestImplement(t *sgo.T) error {
	var a AEAD = &nullAEAD{n: 12}
	out, err := a.Open([]byte{}, []byte{}, a.Seal([]byte{}, []byte{}, []byte("m"), []byte{}), []byte{})
	if err != nil || string(out) != "m" || a.NonceSize() != 12 {
		return sgo.NewError("aead")
	}
	return nil
}

type halfBlock struct{}

func (h *halfBlock) BlockSize() int {
	return 8
}

func (h *halfBlock) Encrypt(dst, src []byte) {
	copy(dst[:8], src[:8])
}

func (h *halfBlock) Decrypt(dst, src []byte) {
	copy(dst[:8], src[:8])
}

// A user type with the three methods is a Block; GCM needs a 16-byte block.
func TestNewGCMBlockSize(t *sgo.T) error {
	var b Block = &halfBlock{}
	if _, err := NewGCM(b); err == nil || err.Error() != "cipher: NewGCM requires 128-bit block cipher" {
		return sgo.NewError("8-byte block accepted")
	}
	return nil
}
