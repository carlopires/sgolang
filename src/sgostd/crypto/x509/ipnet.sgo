// Ported from Go's net (src/net/ip.go) for S-Go (SGO-STD-029, D199): the IP address and
// network operations crypto/x509 uses. Addresses are 4- or 16-byte slices.

package x509

const hexDigits = "0123456789abcdef"

func isV4InV6(ip []byte) bool {
	if len(ip) != 16 {
		return false
	}
	for i := 0; i < 10; i++ {
		if ip[i] != 0 {
			return false
		}
	}
	return ip[10] == 0xff && ip[11] == 0xff
}

func allFF(b []byte) bool {
	for i := 0; i < len(b); i++ {
		if b[i] != 0xff {
			return false
		}
	}
	return true
}

// to4 returns ip as 4 bytes when it is IPv4 or IPv4-mapped IPv6, else an empty slice.
func to4(ip []byte) []byte {
	if len(ip) == 4 {
		return ip
	}
	if isV4InV6(ip) {
		return ip[12:16]
	}
	return []byte{}
}

func ipEqual(a, b []byte) bool {
	if len(a) == len(b) {
		return string(a) == string(b)
	}
	if len(a) == 4 && len(b) == 16 {
		return isV4InV6(b) && string(a) == string(b[12:])
	}
	if len(a) == 16 && len(b) == 4 {
		return isV4InV6(a) && string(a[12:]) == string(b)
	}
	return false
}

func hexString(b []byte) string {
	s := make([]byte, len(b)*2)
	for i := 0; i < len(b); i++ {
		s[i*2] = hexDigits[int(b[i])>>4]
		s[i*2+1] = hexDigits[int(b[i])&15]
	}
	return string(s)
}

// ipString formats ip as net.IP's String: dotted decimal for IPv4 (including IPv4-mapped
// IPv6) and RFC 5952 text for IPv6.
func ipString(ip []byte) string {
	if len(ip) == 0 {
		return "<nil>"
	}
	if len(ip) != 4 && len(ip) != 16 {
		return "?" + hexString(ip)
	}
	p4 := to4(ip)
	if len(p4) == 4 {
		return itoa(int(p4[0])) + "." + itoa(int(p4[1])) + "." + itoa(int(p4[2])) + "." + itoa(int(p4[3]))
	}
	best, bestLen := -1, 0
	for i := 0; i < 8; {
		if ip[2*i] == 0 && ip[2*i+1] == 0 {
			j := i
			for j < 8 && ip[2*j] == 0 && ip[2*j+1] == 0 {
				j++
			}
			if j-i >= 2 && j-i > bestLen {
				best, bestLen = i, j-i
			}
			i = j
		} else {
			i++
		}
	}
	out := []byte{}
	afterGap := false
	for i := 0; i < 8; i++ {
		if i == best {
			out = append(out, ':', ':')
			i += bestLen - 1
			afterGap = true
			continue
		}
		if i > 0 && !afterGap {
			out = append(out, ':')
		}
		afterGap = false
		v := int(ip[2*i])<<8 | int(ip[2*i+1])
		started := false
		for sh := 12; sh >= 0; sh -= 4 {
			d := (v >> sh) & 15
			if d != 0 || started || sh == 0 {
				out = append(out, hexDigits[d])
				started = true
			}
		}
	}
	return string(out)
}

// ipMask applies mask to ip as net.IP's Mask; ok is false when the lengths do not fit.
func ipMask(ip, mask []byte) ([]byte, bool) {
	if len(mask) == 16 && len(ip) == 4 && allFF(mask[:12]) {
		mask = mask[12:]
	}
	if len(mask) == 4 && len(ip) == 16 && isV4InV6(ip) {
		ip = ip[12:]
	}
	if len(ip) != len(mask) {
		return []byte{}, false
	}
	out := make([]byte, len(ip))
	for i := 0; i < len(ip); i++ {
		out[i] = ip[i] & mask[i]
	}
	return out, true
}

func networkNumberAndMask(n IPNet) ([]byte, []byte, bool) {
	ip := to4(n.IP)
	if len(ip) == 0 {
		ip = n.IP
		if len(ip) != 16 {
			return []byte{}, []byte{}, false
		}
	}
	m := n.Mask
	if len(m) == 4 {
		if len(ip) != 4 {
			return []byte{}, []byte{}, false
		}
	} else if len(m) == 16 {
		if len(ip) == 4 {
			m = m[12:]
		}
	} else {
		return []byte{}, []byte{}, false
	}
	return ip, m, true
}

func ipNetContains(n IPNet, ip []byte) bool {
	nn, m, ok := networkNumberAndMask(n)
	if !ok {
		return false
	}
	if x := to4(ip); len(x) == 4 {
		ip = x
	}
	if len(ip) != len(nn) {
		return false
	}
	for i := 0; i < len(ip); i++ {
		if nn[i]&m[i] != ip[i]&m[i] {
			return false
		}
	}
	return true
}

func simpleMaskLength(mask []byte) int {
	n := 0
	for i := 0; i < len(mask); i++ {
		v := int(mask[i])
		if v == 0xff {
			n += 8
			continue
		}
		for v&0x80 != 0 {
			n++
			v = (v << 1) & 0xff
		}
		if v != 0 {
			return -1
		}
		for j := i + 1; j < len(mask); j++ {
			if mask[j] != 0 {
				return -1
			}
		}
		break
	}
	return n
}

// String formats n as net.IPNet's String: "address/prefix", or "address/hexmask" when the
// mask is not a prefix.
func (n IPNet) String() string {
	nn, m, ok := networkNumberAndMask(n)
	if !ok {
		return "<nil>"
	}
	l := simpleMaskLength(m)
	if l == -1 {
		return ipString(nn) + "/" + hexString(m)
	}
	return ipString(nn) + "/" + itoa(l)
}
