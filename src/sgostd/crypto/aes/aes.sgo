// Package aes implements the AES block cipher of FIPS 197 (SGO-STD-027, D199) with the results
// and error texts of Go's crypto/aes. The cipher is bitsliced (after BearSSL's aes_ct64): no
// branch and no memory index depends on the key or the data.
package aes

import (
	"std/bits"
	"std/crypto/cipher"
	"std/encoding/binary"
	"std/errors"
	"std/strconv"
)

// BlockSize is the AES block size in bytes.
const BlockSize = 16

type aesCipher struct {
	rounds int
	skey   []uint64
}

// NewCipher returns an AES cipher for a 16-, 24- or 32-byte key (AES-128, AES-192, AES-256).
func NewCipher(key []byte) (cipher.Block, error) {
	rounds := 0
	if len(key) == 16 {
		rounds = 10
	} else if len(key) == 24 {
		rounds = 12
	} else if len(key) == 32 {
		rounds = 14
	} else {
		return nil, errors.New("crypto/aes: invalid key size " + strconv.Itoa(len(key)))
	}
	return &aesCipher{rounds: rounds, skey: expandKey(key, rounds)}, nil
}

func (c *aesCipher) BlockSize() int {
	return BlockSize
}

// Encrypt encrypts the first block of src into dst; short buffers fail as Go's panics.
func (c *aesCipher) Encrypt(dst, src []byte) {
	if len(src) < BlockSize {
		panic("crypto/aes: input not full block")
	}
	if len(dst) < BlockSize {
		panic("crypto/aes: output not full block")
	}
	q := load(src)
	encrypt(c.rounds, c.skey, q)
	store(dst, q)
}

// Decrypt decrypts the first block of src into dst; short buffers fail as Go's panics.
func (c *aesCipher) Decrypt(dst, src []byte) {
	if len(src) < BlockSize {
		panic("crypto/aes: input not full block")
	}
	if len(dst) < BlockSize {
		panic("crypto/aes: output not full block")
	}
	q := load(src)
	decrypt(c.rounds, c.skey, q)
	store(dst, q)
}

func load(src []byte) []uint64 {
	q := make([]uint64, 8)
	w := []uint32{binary.LittleEndian.Uint32(src[0:4]), binary.LittleEndian.Uint32(src[4:8]), binary.LittleEndian.Uint32(src[8:12]), binary.LittleEndian.Uint32(src[12:16])}
	a, b := interleaveIn(w)
	q[0] = a
	q[4] = b
	ortho(q)
	return q
}

func store(dst []byte, q []uint64) {
	ortho(q)
	w := interleaveOut(q[0], q[4])
	for i := 0; i < 4; i++ {
		binary.LittleEndian.PutUint32(dst[4*i:4*i+4], w[i])
	}
}

func swapN(cl, ch uint64, s int, x, y uint64) (uint64, uint64) {
	return (x & cl) | ((y & cl) << s), ((x & ch) >> s) | (y & ch)
}

func ortho(q []uint64) {
	const c2l uint64 = 0x5555555555555555
	const c2h uint64 = 0xaaaaaaaaaaaaaaaa
	const c4l uint64 = 0x3333333333333333
	const c4h uint64 = 0xcccccccccccccccc
	const c8l uint64 = 0x0f0f0f0f0f0f0f0f
	const c8h uint64 = 0xf0f0f0f0f0f0f0f0
	for i := 0; i < 8; i += 2 {
		q[i], q[i+1] = swapN(c2l, c2h, 1, q[i], q[i+1])
	}
	q[0], q[2] = swapN(c4l, c4h, 2, q[0], q[2])
	q[1], q[3] = swapN(c4l, c4h, 2, q[1], q[3])
	q[4], q[6] = swapN(c4l, c4h, 2, q[4], q[6])
	q[5], q[7] = swapN(c4l, c4h, 2, q[5], q[7])
	for i := 0; i < 4; i++ {
		q[i], q[i+4] = swapN(c8l, c8h, 4, q[i], q[i+4])
	}
}

func spread(x uint64) uint64 {
	x = (x | (x << 16)) & 0x0000ffff0000ffff
	return (x | (x << 8)) & 0x00ff00ff00ff00ff
}

func interleaveIn(w []uint32) (uint64, uint64) {
	x0 := spread(uint64(w[0]))
	x1 := spread(uint64(w[1]))
	x2 := spread(uint64(w[2]))
	x3 := spread(uint64(w[3]))
	return x0 | (x2 << 8), x1 | (x3 << 8)
}

func gather(x uint64) uint32 {
	x = (x | (x >> 8)) & 0x0000ffff0000ffff
	return uint32(x&0xffff) | uint32((x>>16)&0xffff0000)
}

func interleaveOut(q0, q1 uint64) []uint32 {
	const m uint64 = 0x00ff00ff00ff00ff
	return []uint32{gather(q0 & m), gather(q1 & m), gather((q0 >> 8) & m), gather((q1 >> 8) & m)}
}

// sbox applies the AES S-box to the bitsliced state (the circuit of Boyar and Peralta).
func sbox(q []uint64) {
	x0 := q[7]
	x1 := q[6]
	x2 := q[5]
	x3 := q[4]
	x4 := q[3]
	x5 := q[2]
	x6 := q[1]
	x7 := q[0]
	y14 := x3 ^ x5
	y13 := x0 ^ x6
	y9 := x0 ^ x3
	y8 := x0 ^ x5
	t0 := x1 ^ x2
	y1 := t0 ^ x7
	y4 := y1 ^ x3
	y12 := y13 ^ y14
	y2 := y1 ^ x0
	y5 := y1 ^ x6
	y3 := y5 ^ y8
	t1 := x4 ^ y12
	y15 := t1 ^ x5
	y20 := t1 ^ x1
	y6 := y15 ^ x7
	y10 := y15 ^ t0
	y11 := y20 ^ y9
	y7 := x7 ^ y11
	y17 := y10 ^ y11
	y19 := y10 ^ y8
	y16 := t0 ^ y11
	y21 := y13 ^ y16
	y18 := x0 ^ y16
	t2 := y12 & y15
	t3 := y3 & y6
	t4 := t3 ^ t2
	t5 := y4 & x7
	t6 := t5 ^ t2
	t7 := y13 & y16
	t8 := y5 & y1
	t9 := t8 ^ t7
	t10 := y2 & y7
	t11 := t10 ^ t7
	t12 := y9 & y11
	t13 := y14 & y17
	t14 := t13 ^ t12
	t15 := y8 & y10
	t16 := t15 ^ t12
	t17 := t4 ^ t14
	t18 := t6 ^ t16
	t19 := t9 ^ t14
	t20 := t11 ^ t16
	t21 := t17 ^ y20
	t22 := t18 ^ y19
	t23 := t19 ^ y21
	t24 := t20 ^ y18
	t25 := t21 ^ t22
	t26 := t21 & t23
	t27 := t24 ^ t26
	t28 := t25 & t27
	t29 := t28 ^ t22
	t30 := t23 ^ t24
	t31 := t22 ^ t26
	t32 := t31 & t30
	t33 := t32 ^ t24
	t34 := t23 ^ t33
	t35 := t27 ^ t33
	t36 := t24 & t35
	t37 := t36 ^ t34
	t38 := t27 ^ t36
	t39 := t29 & t38
	t40 := t25 ^ t39
	t41 := t40 ^ t37
	t42 := t29 ^ t33
	t43 := t29 ^ t40
	t44 := t33 ^ t37
	t45 := t42 ^ t41
	z0 := t44 & y15
	z1 := t37 & y6
	z2 := t33 & x7
	z3 := t43 & y16
	z4 := t40 & y1
	z5 := t29 & y7
	z6 := t42 & y11
	z7 := t45 & y17
	z8 := t41 & y10
	z9 := t44 & y12
	z10 := t37 & y3
	z11 := t33 & y4
	z12 := t43 & y13
	z13 := t40 & y5
	z14 := t29 & y2
	z15 := t42 & y9
	z16 := t45 & y14
	z17 := t41 & y8
	t46 := z15 ^ z16
	t47 := z10 ^ z11
	t48 := z5 ^ z13
	t49 := z9 ^ z10
	t50 := z2 ^ z12
	t51 := z2 ^ z5
	t52 := z7 ^ z8
	t53 := z0 ^ z3
	t54 := z6 ^ z7
	t55 := z16 ^ z17
	t56 := z12 ^ t48
	t57 := t50 ^ t53
	t58 := z4 ^ t46
	t59 := z3 ^ t54
	t60 := t46 ^ t57
	t61 := z14 ^ t57
	t62 := t52 ^ t58
	t63 := t49 ^ t58
	t64 := z4 ^ t59
	t65 := t61 ^ t62
	t66 := z1 ^ t63
	s0 := t59 ^ t63
	s6 := t56 ^ ^t62
	s7 := t48 ^ ^t60
	t67 := t64 ^ t65
	s3 := t53 ^ t66
	s4 := t51 ^ t66
	s5 := t47 ^ t65
	s1 := t64 ^ ^s3
	s2 := t55 ^ ^t67
	q[7] = s0
	q[6] = s1
	q[5] = s2
	q[4] = s3
	q[3] = s4
	q[2] = s5
	q[1] = s6
	q[0] = s7
}

func invAffine(q []uint64) {
	q0 := ^q[0]
	q1 := ^q[1]
	q2 := q[2]
	q3 := q[3]
	q4 := q[4]
	q5 := ^q[5]
	q6 := ^q[6]
	q7 := q[7]
	q[7] = q1 ^ q4 ^ q6
	q[6] = q0 ^ q3 ^ q5
	q[5] = q7 ^ q2 ^ q4
	q[4] = q6 ^ q1 ^ q3
	q[3] = q5 ^ q0 ^ q2
	q[2] = q4 ^ q7 ^ q1
	q[1] = q3 ^ q6 ^ q0
	q[0] = q2 ^ q5 ^ q7
}

func invSbox(q []uint64) {
	invAffine(q)
	sbox(q)
	invAffine(q)
}

func subWord(x uint32) uint32 {
	q := make([]uint64, 8)
	q[0] = uint64(x)
	ortho(q)
	sbox(q)
	ortho(q)
	return uint32(q[0] & 0xffffffff)
}

func expandKey(key []byte, rounds int) []uint64 {
	nk := len(key) / 4
	nkf := (rounds + 1) * 4
	w := make([]uint32, nkf)
	for i := 0; i < nk; i++ {
		w[i] = binary.LittleEndian.Uint32(key[4*i : 4*i+4])
	}
	rcon := []uint32{0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36}
	tmp := w[nk-1]
	j := 0
	k := 0
	for i := nk; i < nkf; i++ {
		if j == 0 {
			tmp = subWord(bits.RotateLeft32(tmp, 24)) ^ rcon[k]
		} else if nk > 6 && j == 4 {
			tmp = subWord(tmp)
		}
		tmp = tmp ^ w[i-nk]
		w[i] = tmp
		j++
		if j == nk {
			j = 0
			k++
		}
	}
	skey := make([]uint64, 8*(rounds+1))
	for i := 0; i < nkf; i += 4 {
		q := make([]uint64, 8)
		a, b := interleaveIn(w[i : i+4])
		for t := 0; t < 4; t++ {
			q[t] = a
			q[t+4] = b
		}
		ortho(q)
		for t := 0; t < 8; t++ {
			skey[2*i+t] = q[t]
		}
	}
	return skey
}

func addRoundKey(q []uint64, sk []uint64) {
	for i := 0; i < 8; i++ {
		q[i] = q[i] ^ sk[i]
	}
}

func shiftRows(q []uint64) {
	for i := 0; i < 8; i++ {
		x := q[i]
		q[i] = (x & 0x000000000000ffff) |
			((x & 0x00000000fff00000) >> 4) |
			((x & 0x00000000000f0000) << 12) |
			((x & 0x0000ff0000000000) >> 8) |
			((x & 0x000000ff00000000) << 8) |
			((x & 0xf000000000000000) >> 12) |
			((x & 0x0fff000000000000) << 4)
	}
}

func invShiftRows(q []uint64) {
	for i := 0; i < 8; i++ {
		x := q[i]
		q[i] = (x & 0x000000000000ffff) |
			((x & 0x000000000fff0000) << 4) |
			((x & 0x00000000f0000000) >> 12) |
			((x & 0x000000ff00000000) << 8) |
			((x & 0x0000ff0000000000) >> 8) |
			((x & 0x000f000000000000) << 12) |
			((x & 0xfff0000000000000) >> 4)
	}
}

func r32(x uint64) uint64 {
	return bits.RotateLeft64(x, 32)
}

func mixColumns(q []uint64) {
	q0, q1, q2, q3, q4, q5, q6, q7 := q[0], q[1], q[2], q[3], q[4], q[5], q[6], q[7]
	r0 := bits.RotateLeft64(q0, 48)
	r1 := bits.RotateLeft64(q1, 48)
	r2 := bits.RotateLeft64(q2, 48)
	r3 := bits.RotateLeft64(q3, 48)
	r4 := bits.RotateLeft64(q4, 48)
	r5 := bits.RotateLeft64(q5, 48)
	r6 := bits.RotateLeft64(q6, 48)
	r7 := bits.RotateLeft64(q7, 48)
	q[0] = q7 ^ r7 ^ r0 ^ r32(q0^r0)
	q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ r32(q1^r1)
	q[2] = q1 ^ r1 ^ r2 ^ r32(q2^r2)
	q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ r32(q3^r3)
	q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ r32(q4^r4)
	q[5] = q4 ^ r4 ^ r5 ^ r32(q5^r5)
	q[6] = q5 ^ r5 ^ r6 ^ r32(q6^r6)
	q[7] = q6 ^ r6 ^ r7 ^ r32(q7^r7)
}

func invMixColumns(q []uint64) {
	q0, q1, q2, q3, q4, q5, q6, q7 := q[0], q[1], q[2], q[3], q[4], q[5], q[6], q[7]
	r0 := bits.RotateLeft64(q0, 48)
	r1 := bits.RotateLeft64(q1, 48)
	r2 := bits.RotateLeft64(q2, 48)
	r3 := bits.RotateLeft64(q3, 48)
	r4 := bits.RotateLeft64(q4, 48)
	r5 := bits.RotateLeft64(q5, 48)
	r6 := bits.RotateLeft64(q6, 48)
	r7 := bits.RotateLeft64(q7, 48)
	q[0] = q5 ^ q6 ^ q7 ^ r0 ^ r5 ^ r7 ^ r32(q0^q5^q6^r0^r5)
	q[1] = q0 ^ q5 ^ r0 ^ r1 ^ r5 ^ r6 ^ r7 ^ r32(q1^q5^q7^r1^r5^r6)
	q[2] = q0 ^ q1 ^ q6 ^ r1 ^ r2 ^ r6 ^ r7 ^ r32(q0^q2^q6^r2^r6^r7)
	q[3] = q0 ^ q1 ^ q2 ^ q5 ^ q6 ^ r0 ^ r2 ^ r3 ^ r5 ^ r32(q0^q1^q3^q5^q6^q7^r0^r3^r5^r7)
	q[4] = q1 ^ q2 ^ q3 ^ q5 ^ r1 ^ r3 ^ r4 ^ r5 ^ r6 ^ r7 ^ r32(q1^q2^q4^q5^q7^r1^r4^r5^r6)
	q[5] = q2 ^ q3 ^ q4 ^ q6 ^ r2 ^ r4 ^ r5 ^ r6 ^ r7 ^ r32(q2^q3^q5^q6^r2^r5^r6^r7)
	q[6] = q3 ^ q4 ^ q5 ^ q7 ^ r3 ^ r5 ^ r6 ^ r7 ^ r32(q3^q4^q6^q7^r3^r6^r7)
	q[7] = q4 ^ q5 ^ q6 ^ r4 ^ r6 ^ r7 ^ r32(q4^q5^q7^r4^r7)
}

func encrypt(rounds int, skey []uint64, q []uint64) {
	addRoundKey(q, skey[0:8])
	for u := 1; u < rounds; u++ {
		sbox(q)
		shiftRows(q)
		mixColumns(q)
		addRoundKey(q, skey[8*u:8*u+8])
	}
	sbox(q)
	shiftRows(q)
	addRoundKey(q, skey[8*rounds:8*rounds+8])
}

func decrypt(rounds int, skey []uint64, q []uint64) {
	addRoundKey(q, skey[8*rounds:8*rounds+8])
	for u := rounds - 1; u > 0; u-- {
		invShiftRows(q)
		invSbox(q)
		addRoundKey(q, skey[8*u:8*u+8])
		invMixColumns(q)
	}
	invShiftRows(q)
	invSbox(q)
	addRoundKey(q, skey[0:8])
}
