package rsa

import (
	"sgo"
	"std/crypto/sha256"
	"std/encoding/hex"
)

func unhex(s string) []byte {
	b, _ := hex.DecodeString(s)
	return b
}

func key() *PublicKey {
	return &PublicKey{N: unhex(""), E: 65537}
}

// Wycheproof rsa_signature_2048_sha256 tcId 1 (the empty message), and changes that break it.
func TestPKCS1v15(t *sgo.T) error {
	sig := unhex("")
	h := sha256.Sum256([]byte{})
	if err := VerifyPKCS1v15(key(), SHA256, h[:], sig); err != nil {
		return err
	}
	h2 := sha256.Sum256([]byte("x"))
	e1 := VerifyPKCS1v15(key(), SHA256, h2[:], sig)
	if e1 == nil || e1.Error() != "crypto/rsa: verification error" {
		return sgo.NewError("other message accepted")
	}
	if e2 := VerifyPKCS1v15(key(), SHA384, h[:], sig); e2 == nil {
		return sgo.NewError("wrong hash accepted")
	}
	if e3 := VerifyPKCS1v15(key(), SHA256, h[:], sig[1:]); e3 == nil {
		return sgo.NewError("short signature accepted")
	}
	return nil
}

func TestKeyChecks(t *sgo.T) error {
	h := sha256.Sum256([]byte{})
	sig := unhex("")
	k := key()
	k.E = 3 + 1
	if err := VerifyPKCS1v15(k, SHA256, h[:], sig); err == nil || err.Error() != "crypto/rsa: public exponent is even" {
		return sgo.NewError("even exponent accepted")
	}
	small := &PublicKey{N: unhex("c3"), E: 65537}
	if e2 := VerifyPKCS1v15(small, SHA256, h[:], []byte{1}); e2 == nil || e2.Error() != "crypto/rsa: 8-bit keys are insecure (see https://go.dev/pkg/crypto/rsa#hdr-Minimum_key_size)" {
		return sgo.NewError("small key accepted")
	}
	if e3 := VerifyPSS(key(), SHA256, h[:], sig, -2); e3 == nil || e3.Error() != "crypto/rsa: salt length cannot be negative" {
		return sgo.NewError("negative salt length accepted")
	}
	return nil
}
