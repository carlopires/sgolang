// Package rsa implements RSA signature verification, PKCS #1 v1.5 and PSS (RFC 8017), with
// SHA-256, SHA-384 and SHA-512 (SGO-STD-026, D199), with the results and error texts of Go's
// crypto/rsa VerifyPKCS1v15 and VerifyPSS. Verification uses only public values.
package rsa

import (
	"std/crypto/bigmod"
	"std/crypto/sha256"
	"std/crypto/sha512"
	"std/errors"
	"std/hash"
	"std/strconv"
)

// A PublicKey is an RSA public key: the modulus N as big-endian bytes and the exponent E.
type PublicKey struct {
	N []byte
	E int
}

// A Hash names the hash function a signature was made with.
type Hash int

const (
	// SHA256 is SHA-256.
	SHA256 Hash = 1
	// SHA384 is SHA-384.
	SHA384 Hash = 2
	// SHA512 is SHA-512.
	SHA512 Hash = 3
)

const (
	// PSSSaltLengthAuto makes VerifyPSS detect the salt length.
	PSSSaltLengthAuto = 0
	// PSSSaltLengthEqualsHash makes VerifyPSS require a salt as long as the hash.
	PSSSaltLengthEqualsHash = -1
)

func verificationError() error {
	return errors.New("crypto/rsa: verification error")
}

func newHash(h Hash) hash.Hash {
	if h == SHA384 {
		return sha512.New384()
	}
	if h == SHA512 {
		return sha512.New()
	}
	return sha256.New()
}

func knownHash(h Hash) bool {
	return h == SHA256 || h == SHA384 || h == SHA512
}

func digestInfoPrefix(h Hash) []byte {
	if h == SHA384 {
		return []byte{0x30, 0x41, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02, 0x05, 0x00, 0x04, 0x30}
	}
	if h == SHA512 {
		return []byte{0x30, 0x51, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03, 0x05, 0x00, 0x04, 0x40}
	}
	return []byte{0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20}
}

// checkKey returns the modulus of pub after the checks of Go's crypto/rsa.
func checkKey(pub *PublicKey) (*bigmod.Modulus, error) {
	n := pub.N
	for len(n) > 0 && n[0] == 0 {
		n = n[1:]
	}
	if len(n) == 0 {
		return nil, errors.New("crypto/rsa: missing public modulus")
	}
	if n[len(n)-1]&1 == 0 {
		return nil, errors.New("crypto/rsa: public modulus is even")
	}
	m, err := bigmod.NewModulus(n)
	if err != nil {
		return nil, errors.New("crypto/rsa: public modulus is even")
	}
	if m.BitLen() < 1024 {
		return nil, errors.New("crypto/rsa: " + strconv.Itoa(m.BitLen()) + "-bit keys are insecure (see https://go.dev/pkg/crypto/rsa#hdr-Minimum_key_size)")
	}
	if pub.E < 2 {
		return nil, errors.New("crypto/rsa: public exponent too small or negative")
	}
	if pub.E&1 == 0 {
		return nil, errors.New("crypto/rsa: public exponent is even")
	}
	if pub.E > 2147483647 {
		return nil, errors.New("crypto/rsa: public exponent too large")
	}
	return m, nil
}

// encrypt returns sig^E mod N, or false when sig is not below N.
func encrypt(m *bigmod.Modulus, e int, sig []byte) ([]byte, bool) {
	x, err := bigmod.NewNat().SetBytes(sig, m)
	if err != nil {
		return nil, false
	}
	return bigmod.NewNat().ExpShortVarTime(x, uint64(e), m).Bytes(m), true
}

func equal(a, b []byte) bool {
	if len(a) != len(b) {
		return false
	}
	var v byte = 0
	for i := 0; i < len(a); i++ {
		v = v | (a[i] ^ b[i])
	}
	return v == 0
}

// VerifyPKCS1v15 checks sig, an RSASSA-PKCS1-v1_5 signature of the digest hashed made with h, by
// pub. It returns nil for a valid signature and an error otherwise.
func VerifyPKCS1v15(pub *PublicKey, h Hash, hashed []byte, sig []byte) error {
	if !knownHash(h) {
		return errors.New("crypto/rsa: unsupported hash function")
	}
	m, err := checkKey(pub)
	if err != nil {
		return err
	}
	k := m.Size()
	if len(sig) != k {
		return verificationError()
	}
	em, ok := encrypt(m, pub.E, sig)
	if !ok {
		return verificationError()
	}
	prefix := digestInfoPrefix(h)
	if len(hashed) != newHash(h).Size() {
		return verificationError()
	}
	tLen := len(prefix) + len(hashed)
	if k < tLen+11 {
		return verificationError()
	}
	want := make([]byte, k)
	want[1] = 1
	for i := 2; i < k-tLen-1; i++ {
		want[i] = 0xff
	}
	copy(want[k-tLen:], prefix)
	copy(want[k-len(hashed):], hashed)
	if !equal(em, want) {
		return verificationError()
	}
	return nil
}

func mgf1XOR(out []byte, h Hash, seed []byte) {
	done := 0
	counter := 0
	for done < len(out) {
		d := newHash(h)
		_, _ = d.Write(seed)
		_, _ = d.Write([]byte{byte(counter >> 24), byte((counter >> 16) & 0xff), byte((counter >> 8) & 0xff), byte(counter & 0xff)})
		t := d.Sum([]byte{})
		for i := 0; i < len(t) && done < len(out); i++ {
			out[done] = out[done] ^ t[i]
			done++
		}
		counter++
	}
}

// VerifyPSS checks sig, an RSASSA-PSS signature of the digest made with h (and MGF1 with h), by
// pub. saltLength is PSSSaltLengthAuto, PSSSaltLengthEqualsHash, or the salt length in bytes.
func VerifyPSS(pub *PublicKey, h Hash, digest []byte, sig []byte, saltLength int) error {
	if !knownHash(h) {
		return errors.New("crypto/rsa: unsupported hash function")
	}
	hLen := newHash(h).Size()
	sLen := saltLength
	if saltLength == PSSSaltLengthEqualsHash {
		sLen = hLen
	} else if saltLength < 0 {
		return errors.New("crypto/rsa: salt length cannot be negative")
	}
	auto := saltLength == PSSSaltLengthAuto
	m, err := checkKey(pub)
	if err != nil {
		return err
	}
	if len(sig) != m.Size() {
		return verificationError()
	}
	emBits := m.BitLen() - 1
	emLen := (emBits + 7) / 8
	em, ok := encrypt(m, pub.E, sig)
	if !ok {
		return verificationError()
	}
	for len(em) > emLen && len(em) > 0 {
		if em[0] != 0 {
			return verificationError()
		}
		em = em[1:]
	}
	if hLen != len(digest) {
		return verificationError()
	}
	if auto {
		sLen = 0
	}
	if emLen < hLen+sLen+2 {
		return verificationError()
	}
	if em[emLen-1] != 0xbc {
		return verificationError()
	}
	db := make([]byte, emLen-hLen-1)
	copy(db, em[:emLen-hLen-1])
	hh := em[emLen-hLen-1 : emLen-1]
	full := 0xff
	bitMask := byte(full >> (8*emLen - emBits))
	if em[0]&^bitMask != 0 {
		return verificationError()
	}
	mgf1XOR(db, h, hh)
	db[0] = db[0] & bitMask
	if auto {
		ps := -1
		for i := 0; i < len(db); i++ {
			if db[i] == 1 {
				ps = i
				break
			}
		}
		if ps < 0 {
			return verificationError()
		}
		sLen = len(db) - ps - 1
	}
	psLen := emLen - hLen - sLen - 2
	for i := 0; i < psLen; i++ {
		if db[i] != 0 {
			return verificationError()
		}
	}
	if db[psLen] != 1 {
		return verificationError()
	}
	salt := db[len(db)-sLen:]
	d := newHash(h)
	_, _ = d.Write(make([]byte, 8))
	_, _ = d.Write(digest)
	_, _ = d.Write(salt)
	if !equal(d.Sum([]byte{}), hh) {
		return verificationError()
	}
	return nil
}
