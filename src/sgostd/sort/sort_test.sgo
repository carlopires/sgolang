package sort

import "sgo"

func TestPermStable(t *sgo.T) error {
	// Key of index i is i%3 (computed, so less captures nothing): keys 0 1 2 0 1 2 0 1.
	p := Perm(8, func(i, j int) bool { return i%3 < j%3 })
	want := []int{0, 3, 6, 1, 4, 7, 2, 5}
	for k := range want {
		if p[k] != want[k] {
			return sgo.NewError("Perm is not the stable order")
		}
	}
	if len(Perm(0, func(i, j int) bool { return false })) != 0 {
		return sgo.NewError("Perm(0)")
	}
	return nil
}

func TestTypedSorts(t *sgo.T) error {
	x := []int{5, -1, 3, 3, 9223372036854775807, -9223372036854775807 - 1, 0}
	Ints(x)
	if !IntsAreSorted(x) || x[0] != -9223372036854775807-1 || x[6] != 9223372036854775807 {
		return sgo.NewError("Ints")
	}
	s := []string{"b", "", "\u00e9", "a", "B"}
	Strings(s)
	if !StringsAreSorted(s) || s[0] != "" || s[1] != "B" || s[4] != "\u00e9" {
		return sgo.NewError("Strings")
	}
	r := []rune{0x10FFFF, 'a', 0}
	Runes(r)
	b := []byte("zay")
	Bytes(b)
	if r[0] != 0 || r[2] != 0x10FFFF || string(b) != "ayz" {
		return sgo.NewError("Runes/Bytes")
	}
	return nil
}

func TestSearch(t *sgo.T) error {
	a := []int{1, 3, 3, 7}
	if SearchInts(a, 3) != 1 || SearchInts(a, 0) != 0 || SearchInts(a, 8) != 4 || SearchInts(nil, 1) != 0 {
		return sgo.NewError("SearchInts")
	}
	if SearchStrings([]string{"a", "c"}, "b") != 1 {
		return sgo.NewError("SearchStrings")
	}
	if Search(100, func(i int) bool { return i*i >= 50 }) != 8 {
		return sgo.NewError("Search")
	}
	return nil
}
