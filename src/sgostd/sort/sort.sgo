// Package sort sorts slices and searches sorted data (SGO-STD-006). Every sort is stable and uses
// one merge sort (D123), so results are the same on every platform and run.
package sort

// Perm returns the indices 0..n-1 in stable sorted order under less: Perm(n, less)[k] is the index
// of the k-th smallest element, and equal elements keep their index order. less must be a strict
// weak order; if it is not, the result is still a permutation of 0..n-1, the one this merge sort
// produces. A negative n panics. A function value that captures task-local data cannot be passed
// as an argument (SGO-COMP-004, D94), so less computes from the indices or from shareable data.
func Perm(n int, less func(i, j int) bool) []int {
	if n < 0 {
		panic("sort.Perm: negative length")
	}
	return mergePerm(n, byLess, nil, nil, less)
}

// Comparison modes of mergePerm. Function values have no nil (SGO-TYPE-003), so the typed sorts
// pass never as less.
const (
	byLess    = 0
	byInts    = 1
	byStrings = 2
)

func never(i, j int) bool { return false }

// mergePerm is the one stable merge sort (D123) of the indices 0..n-1, comparing by less, by ik
// (ints), or by sk (strings), as mode says.
func mergePerm(n int, mode int, ik []int, sk []string, less func(i, j int) bool) []int {
	p := make([]int, n)
	for i := range p {
		p[i] = i
	}
	tmp := make([]int, n)
	for width := 1; width < n; width *= 2 {
		for lo := 0; lo < n; lo += 2 * width {
			mid := lo + width
			if mid > n {
				mid = n
			}
			hi := lo + 2*width
			if hi > n {
				hi = n
			}
			i, j, k := lo, mid, lo
			for i < mid && j < hi {
				before := false
				switch mode {
				case byLess:
					before = less(p[j], p[i])
				case byInts:
					before = ik[p[j]] < ik[p[i]]
				default:
					before = sk[p[j]] < sk[p[i]]
				}
				if before {
					tmp[k] = p[j]
					j++
				} else {
					tmp[k] = p[i]
					i++
				}
				k++
			}
			for ; i < mid; i++ {
				tmp[k] = p[i]
				k++
			}
			for ; j < hi; j++ {
				tmp[k] = p[j]
				k++
			}
		}
		p, tmp = tmp, p
	}
	return p
}

// Ints sorts x in increasing order.
func Ints(x []int) {
	y := append([]int{}, x...)
	for k, i := range mergePerm(len(y), byInts, y, nil, never) {
		x[k] = y[i]
	}
}

// Strings sorts x in increasing order (by bytes).
func Strings(x []string) {
	y := append([]string{}, x...)
	for k, i := range mergePerm(len(y), byStrings, nil, y, never) {
		x[k] = y[i]
	}
}

// Runes sorts x in increasing order.
func Runes(x []rune) {
	y := make([]int, len(x))
	for i, r := range x {
		y[i] = int(r)
	}
	for k, i := range mergePerm(len(y), byInts, y, nil, never) {
		x[k] = rune(y[i])
	}
}

// Bytes sorts x in increasing order.
func Bytes(x []byte) {
	y := make([]int, len(x))
	for i, b := range x {
		y[i] = int(b)
	}
	for k, i := range mergePerm(len(y), byInts, y, nil, never) {
		x[k] = byte(y[i])
	}
}

// IntsAreSorted reports whether x is in increasing order.
func IntsAreSorted(x []int) bool {
	for i := len(x) - 1; i > 0; i-- {
		if x[i] < x[i-1] {
			return false
		}
	}
	return true
}

// StringsAreSorted reports whether x is in increasing order.
func StringsAreSorted(x []string) bool {
	for i := len(x) - 1; i > 0; i-- {
		if x[i] < x[i-1] {
			return false
		}
	}
	return true
}

// Search returns the smallest index i in [0, n) at which f(i) is true, assuming f is false then
// true over the range, or n if there is none.
func Search(n int, f func(int) bool) int {
	i, j := 0, n
	for i < j {
		h := i + (j-i)/2
		if !f(h) {
			i = h + 1
		} else {
			j = h
		}
	}
	return i
}

// SearchInts returns the index at which x is, or would be inserted, in the sorted slice a.
func SearchInts(a []int, x int) int {
	i, j := 0, len(a)
	for i < j {
		h := i + (j-i)/2
		if a[h] < x {
			i = h + 1
		} else {
			j = h
		}
	}
	return i
}

// SearchStrings returns the index at which x is, or would be inserted, in the sorted slice a.
func SearchStrings(a []string, x string) int {
	i, j := 0, len(a)
	for i < j {
		h := i + (j-i)/2
		if a[h] < x {
			i = h + 1
		} else {
			j = h
		}
	}
	return i
}

// Interface is a collection that can be sorted by Sort: Len is the number of elements, Less reports
// whether element i sorts before element j, and Swap exchanges elements i and j (SGO-STD-006, D133).
type Interface interface {
	Len() int
	Less(i, j int) bool
	Swap(i, j int)
}

// Sort sorts data in increasing order of Less. It is stable, like every S-Go sort (D123): equal
// elements keep their order. It calls Less O(n*log(n)) and Swap O(n*log(n)*log(n)) times, using
// insertion-sorted blocks merged by SymMerge (Kim and Kutzner), with no extra memory.
func Sort(data Interface) {
	n := data.Len()
	blockSize := 20
	a, b := 0, blockSize
	for b <= n {
		insertionSort(data, a, b)
		a = b
		b = b + blockSize
	}
	insertionSort(data, a, n)
	for blockSize < n {
		a, b = 0, 2*blockSize
		for b <= n {
			symMerge(data, a, a+blockSize, b)
			a = b
			b = b + 2*blockSize
		}
		if a+blockSize < n {
			symMerge(data, a, a+blockSize, n)
		}
		blockSize = blockSize * 2
	}
}

// isSorted reports whether data is sorted in increasing order of Less.
func isSorted(data Interface) bool {
	for i := data.Len() - 1; i > 0; i-- {
		if data.Less(i, i-1) {
			return false
		}
	}
	return true
}

func insertionSort(data Interface, a, b int) {
	for i := a + 1; i < b; i++ {
		for j := i; j > a && data.Less(j, j-1); j-- {
			data.Swap(j, j-1)
		}
	}
}

// symMerge merges the sorted runs data[a:m] and data[m:b] stably.
func symMerge(data Interface, a, m, b int) {
	if m-a == 1 {
		// Insert data[a] into data[m:b] after the last element not greater than it.
		i, j := m, b
		for i < j {
			h := (i + j) / 2
			if data.Less(h, a) {
				i = h + 1
			} else {
				j = h
			}
		}
		for k := a; k < i-1; k++ {
			data.Swap(k, k+1)
		}
		return
	}
	if b-m == 1 {
		// Insert data[m] into data[a:m] before the first element greater than it.
		i, j := a, m
		for i < j {
			h := (i + j) / 2
			if !data.Less(m, h) {
				i = h + 1
			} else {
				j = h
			}
		}
		for k := m; k > i; k-- {
			data.Swap(k, k-1)
		}
		return
	}
	mid := (a + b) / 2
	n := mid + m
	start, r := a, m
	if m > mid {
		start, r = n-b, mid
	}
	p := n - 1
	for start < r {
		c := (start + r) / 2
		if !data.Less(p-c, c) {
			start = c + 1
		} else {
			r = c
		}
	}
	end := n - start
	if start < m && m < end {
		rotate(data, start, m, end)
	}
	if a < start && start < mid {
		symMerge(data, a, start, mid)
	}
	if mid < end && end < b {
		symMerge(data, mid, end, b)
	}
}

// rotate exchanges the runs data[a:m] and data[m:b].
func rotate(data Interface, a, m, b int) {
	i := m - a
	j := b - m
	for i != j {
		if i > j {
			swapRange(data, m-i, m, j)
			i = i - j
		} else {
			swapRange(data, m-i, m+j-i, i)
			j = j - i
		}
	}
	swapRange(data, m-i, m, i)
}

func swapRange(data Interface, a, b, n int) {
	for i := 0; i < n; i++ {
		data.Swap(a+i, b+i)
	}
}
