// Package errors creates error values (SGO-STD-001). Is, As, Unwrap, and Join need interfaces and
// type assertions and come with them (D121).
package errors

import "sgo"

// New returns an error whose Error method returns text. Each call returns a distinct value; error
// values are not comparable (SGO-TYPE-006).
func New(text string) error {
	return sgo.NewError(text)
}

// wrapper is an error that wraps another.
type wrapper interface {
	Unwrap() error
}

// Unwrap returns the result of calling err's Unwrap method, or nil if err is nil or has no
// Unwrap() error method (SGO-STD-001, D133).
func Unwrap(err error) error {
	if w, ok := err.(wrapper); ok {
		return w.Unwrap()
	}
	return nil
}
