package math

// The correctly rounded float64 functions (SGO-STD-011, D192), in S-Go: the algorithms are Go's
// portable ones (mod.go, sqrt.go, ldexp.go), so the results are Go's, and identical on every target.

// Mathematical constants and limits, as in Go.
const (
	E   = 2.71828182845904523536028747135266249775724709369995957496696763
	Pi  = 3.14159265358979323846264338327950288419716939937510582097494459
	Phi = 1.61803398874989484820458683436563811772030917980576286213544862

	Sqrt2   = 1.41421356237309504880168872420969807856967187537694807317667974
	SqrtE   = 1.64872127070012814684865078831848487189826896155713236227627543
	SqrtPi  = 1.77245385090551602729816748334114518279754945612238712821380779
	SqrtPhi = 1.27201964951406896425242246173749149171560804184009624861664038

	Ln2    = 0.693147180559945309417232121458176568075500134360255254120680009
	Log2E  = 1 / Ln2
	Ln10   = 2.30258509299404568401799145468436420760110148862877297603332790
	Log10E = 1 / Ln10

	MaxFloat64             = 0x1p1023 * (1 + (1 - 0x1p-52))
	SmallestNonzeroFloat64 = 0x1p-1022 * 0x1p-52
	smallestNormal         = 0x1p-1022
)

// Abs returns the absolute value of x: Abs(±Inf) = +Inf, Abs(NaN) = NaN.
func Abs(x float64) float64 {
	if x < 0 || x == 0 && Signbit(x) {
		return -x
	}
	return x
}

// Copysign returns a value with the magnitude of f and the sign of sign (positive for the NaN).
func Copysign(f, sign float64) float64 {
	if Signbit(sign) {
		return -Abs(f)
	}
	return Abs(f)
}

// Trunc returns the integer value of x, toward zero. Trunc(±0), Trunc(±Inf), and Trunc(NaN) are
// x.
func Trunc(x float64) float64 {
	if x == 0 || x != x || Abs(x) >= two52 {
		return x // ±0, NaN, ±Inf, and every integer of 2^52 or more
	}
	t := float64(int(x)) // |x| < 2^52: in range, and exact
	if t == 0 {
		return Copysign(0, x)
	}
	return t
}

// Floor returns the greatest integer value less than or equal to x.
func Floor(x float64) float64 {
	t := Trunc(x)
	if t > x {
		return t - 1
	}
	return t
}

// Ceil returns the least integer value greater than or equal to x.
func Ceil(x float64) float64 {
	t := Trunc(x)
	if t < x {
		return t + 1
	}
	return t
}

// Round returns the nearest integer, rounding half away from zero.
func Round(x float64) float64 {
	t := Trunc(x)
	if Abs(x-t) >= 0.5 { // x - t is exact
		return t + Copysign(1, x)
	}
	return t
}

// RoundToEven returns the nearest integer, rounding ties to even.
func RoundToEven(x float64) float64 {
	t := Trunc(x)
	d := Abs(x - t)
	if d > 0.5 || d == 0.5 && int(t)&1 == 1 {
		return t + Copysign(1, x)
	}
	return t
}

// Modf returns the integer and fractional parts of f, both with the sign of f. Modf(±Inf) is
// (±Inf, NaN); Modf(NaN) is (NaN, NaN).
func Modf(f float64) (float64, float64) {
	if IsInf(f, 0) {
		return f, NaN()
	}
	i := Trunc(f)
	frac := f - i
	if frac == 0 {
		frac = Copysign(0, f)
	}
	return i, frac
}

// Frexp breaks f into a fraction in [0.5, 1) and a power of two: f == frac × 2^exp. Frexp(±0),
// Frexp(±Inf), and Frexp(NaN) are (f, 0).
func Frexp(f float64) (float64, int) {
	if f == 0 || IsInf(f, 0) || f != f {
		return f, 0
	}
	exp := 0
	if Abs(f) < smallestNormal {
		f *= two52
		exp = -52
	}
	b := Float64bits(f)
	exp += (b>>expShift)&0x7FF - 1022
	b = b&^(0x7FF<<expShift) | 1022<<expShift
	return Float64frombits(b), exp
}

// Ldexp returns frac × 2^exp, rounded once (Go's algorithm).
func Ldexp(frac float64, exp int) float64 {
	if frac == 0 || IsInf(frac, 0) || frac != frac {
		return frac
	}
	if Abs(frac) < smallestNormal {
		frac *= two52
		exp -= 52
	}
	b := Float64bits(frac)
	exp += (b>>expShift)&0x7FF - expBias
	if exp < -1075 {
		return Copysign(0, frac)
	}
	if exp > 1023 {
		return Copysign(Inf(1), frac)
	}
	m := 1.0
	if exp < -1022 { // subnormal: one rounding, by the final multiplication
		exp += 53
		m = 0x1p-53
	}
	b = b&^(0x7FF<<expShift) | (exp+expBias)<<expShift
	return m * Float64frombits(b)
}

// Min returns the smaller of x and y: Min(x, -Inf) = -Inf, Min(x, NaN) = NaN, Min(-0, ±0) = -0.
func Min(x, y float64) float64 {
	switch {
	case IsInf(x, -1) || IsInf(y, -1):
		return Inf(-1)
	case x != x || y != y:
		return NaN()
	case x == 0 && x == y:
		if Signbit(x) {
			return x
		}
		return y
	case x < y:
		return x
	}
	return y
}

// Max returns the larger of x and y: Max(x, +Inf) = +Inf, Max(x, NaN) = NaN, Max(+0, ±0) = +0.
func Max(x, y float64) float64 {
	switch {
	case IsInf(x, 1) || IsInf(y, 1):
		return Inf(1)
	case x != x || y != y:
		return NaN()
	case x == 0 && x == y:
		if Signbit(x) {
			return y
		}
		return x
	case x > y:
		return x
	}
	return y
}

// Nextafter returns the next representable float64 after x towards y.
func Nextafter(x, y float64) float64 {
	switch {
	case x != x || y != y:
		return NaN()
	case x == y:
		return x
	case x == 0:
		return Copysign(Float64frombits(1), y)
	case (y > x) == (x > 0):
		return Float64frombits(Float64bits(x) + 1)
	}
	return Float64frombits(Float64bits(x) - 1)
}

// Mod returns the remainder of x/y, with the sign of x: Mod(±Inf, y), Mod(NaN, y), Mod(x, 0), and
// Mod(x, NaN) are NaN; Mod(x, ±Inf) is x. Exact.
func Mod(x, y float64) float64 {
	if y == 0 || IsInf(x, 0) || x != x || y != y {
		return NaN()
	}
	y = Abs(y)
	yfr, yexp := Frexp(y)
	r := x
	if x < 0 {
		r = -x
	}
	for r >= y {
		rfr, rexp := Frexp(r)
		if rfr < yfr {
			rexp--
		}
		r = r - Ldexp(y, rexp-yexp)
	}
	if x < 0 {
		r = -r
	}
	return r
}

// Sqrt returns the square root of x, correctly rounded: Sqrt(+Inf) = +Inf, Sqrt(±0) = ±0,
// Sqrt(x < 0) = NaN, Sqrt(NaN) = NaN. Go's bit-by-bit algorithm.
func Sqrt(x float64) float64 {
	switch {
	case x == 0 || x != x || IsInf(x, 1):
		return x
	case x < 0:
		return NaN()
	}
	ix := Float64bits(x)
	exp := (ix >> expShift) & 0x7FF
	if exp == 0 { // subnormal: normalize
		for ix&(1<<expShift) == 0 {
			ix <<= 1
			exp--
		}
		exp++
	}
	exp -= expBias
	ix = ix&^(0x7FF<<expShift) | 1<<expShift
	if exp&1 == 1 {
		ix <<= 1
	}
	exp >>= 1
	ix <<= 1
	q, s := 0, 0
	r := 1 << (expShift + 1)
	for r != 0 {
		t := s + r
		if t <= ix {
			s = t + r
			ix -= t
			q += r
		}
		ix <<= 1
		r >>= 1
	}
	if ix != 0 { // remainder: round to nearest, ties to even
		q += q & 1
	}
	return Float64frombits(q>>1 + (exp-1+expBias)<<expShift)
}
