// Package math provides the float64 functions under Go's names (SGO-STD-011, D191, D192) and the
// integer helpers IntAbs, IntMin, IntMax, IntPow (SGO-STD-007 v2).
package math

const (
	MaxInt = 9223372036854775807    // the largest int
	MinInt = -9223372036854775807 - 1 // the smallest int
)

// IntAbs returns the absolute value of x. IntAbs(MinInt) is IntegerOverflow.
func IntAbs(x int) int {
	if x < 0 {
		return -x
	}
	return x
}

// IntMin returns the smaller of a and b.
func IntMin(a, b int) int {
	if a < b {
		return a
	}
	return b
}

// IntMax returns the larger of a and b.
func IntMax(a, b int) int {
	if a > b {
		return a
	}
	return b
}

// IntPow returns x to the power n (IntPow(x, 0) is 1). A negative n panics; a result outside the range
// of int is IntegerOverflow. x is squared only while bits of n remain, so an intermediate
// overflow happens only when the result itself is out of range.
func IntPow(x, n int) int {
	if n < 0 {
		panic("math.IntPow: negative exponent")
	}
	result := 1
	for {
		if n%2 == 1 {
			result *= x
		}
		n /= 2
		if n == 0 {
			return result
		}
		x *= x
	}
}
