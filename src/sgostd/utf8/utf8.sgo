// Package utf8 encodes and decodes UTF-8 text (SGO-STD-005), as Go's unicode/utf8. Decoding
// follows D117: an invalid or truncated sequence, an overlong form, or an encoded surrogate
// decodes to RuneError and advances one byte, exactly as range over a string does.
package utf8

const (
	RuneError = '\uFFFD'     // the "error" rune, U+FFFD
	RuneSelf  = 0x80         // bytes below RuneSelf are single-byte runes
	MaxRune   = '\U0010FFFF' // the largest rune
	UTFMax    = 4            // the largest number of bytes of an encoded rune
)

// Bounds of continuation bytes.
const (
	locb = 0x80
	hicb = 0xBF
)

// lead returns the encoded length n of a sequence starting with b (0 when b cannot start one)
// and the bounds lo, hi of its second byte.
func lead(b byte) (int, byte, byte) {
	switch {
	case b < 0x80:
		return 1, 0, 0
	case b < 0xC2:
		return 0, 0, 0
	case b < 0xE0:
		return 2, locb, hicb
	case b == 0xE0:
		return 3, 0xA0, hicb
	case b < 0xED:
		return 3, locb, hicb
	case b == 0xED:
		return 3, locb, 0x9F
	case b < 0xF0:
		return 3, locb, hicb
	case b == 0xF0:
		return 4, 0x90, hicb
	case b < 0xF4:
		return 4, locb, hicb
	case b == 0xF4:
		return 4, locb, 0x8F
	}
	return 0, 0, 0
}

func cont(b byte) bool {
	return locb <= b && b <= hicb
}

// DecodeRuneInString returns the first rune of s and its width in bytes. An empty s gives
// (RuneError, 0); an invalid encoding gives (RuneError, 1).
func DecodeRuneInString(s string) (rune, int) {
	if len(s) < 1 {
		return RuneError, 0
	}
	p0 := s[0]
	n, lo, hi := lead(p0)
	if n == 1 {
		return rune(p0), 1
	}
	if n == 0 || len(s) < n {
		return RuneError, 1
	}
	if s[1] < lo || hi < s[1] {
		return RuneError, 1
	}
	if n == 2 {
		return rune(p0&0x1F)<<6 | rune(s[1]&0x3F), 2
	}
	if !cont(s[2]) {
		return RuneError, 1
	}
	if n == 3 {
		return rune(p0&0x0F)<<12 | rune(s[1]&0x3F)<<6 | rune(s[2]&0x3F), 3
	}
	if !cont(s[3]) {
		return RuneError, 1
	}
	return rune(p0&0x07)<<18 | rune(s[1]&0x3F)<<12 | rune(s[2]&0x3F)<<6 | rune(s[3]&0x3F), 4
}

// DecodeRune is DecodeRuneInString of the bytes of p.
func DecodeRune(p []byte) (rune, int) {
	return DecodeRuneInString(string(p[:prefix(len(p))]))
}

// DecodeLastRuneInString returns the last rune of s and its width in bytes. An empty s gives
// (RuneError, 0); an invalid encoding gives (RuneError, 1).
func DecodeLastRuneInString(s string) (rune, int) {
	end := len(s)
	if end == 0 {
		return RuneError, 0
	}
	start := end - 1
	if s[start] < RuneSelf {
		return rune(s[start]), 1
	}
	lim := end - UTFMax
	if lim < 0 {
		lim = 0
	}
	for start--; start >= lim; start-- {
		if RuneStart(s[start]) {
			break
		}
	}
	if start < 0 {
		start = 0
	}
	r, size := DecodeRuneInString(s[start:end])
	if start+size != end {
		return RuneError, 1
	}
	return r, size
}

// DecodeLastRune is DecodeLastRuneInString of the bytes of p.
func DecodeLastRune(p []byte) (rune, int) {
	return DecodeLastRuneInString(string(p[len(p)-prefix(len(p)):]))
}

// prefix returns min(n, UTFMax).
func prefix(n int) int {
	if n < UTFMax {
		return n
	}
	return UTFMax
}

// FullRuneInString reports whether s begins with a full encoding of a rune; an invalid encoding
// counts as full, since it decodes as a width-1 RuneError.
func FullRuneInString(s string) bool {
	if len(s) == 0 {
		return false
	}
	n, lo, hi := lead(s[0])
	if n <= 1 || len(s) >= n {
		return true
	}
	if len(s) > 1 && (s[1] < lo || hi < s[1]) {
		return true
	}
	if len(s) > 2 && !cont(s[2]) {
		return true
	}
	return false
}

// FullRune is FullRuneInString of the bytes of p.
func FullRune(p []byte) bool {
	return FullRuneInString(string(p[:prefix(len(p))]))
}

// RuneLen returns the number of bytes of the encoding of r, or -1 if r is a surrogate.
func RuneLen(r rune) int {
	switch {
	case r < 0x80:
		return 1
	case r < 0x800:
		return 2
	case 0xD800 <= r && r <= 0xDFFF:
		return -1
	case r < 0x10000:
		return 3
	}
	return 4
}

// EncodeRune writes the UTF-8 encoding of r into p and returns the number of bytes written; a
// surrogate is written as RuneError. p must be long enough (BoundsViolation otherwise, as Go
// panics).
func EncodeRune(p []byte, r rune) int {
	if 0xD800 <= r && r <= 0xDFFF {
		r = RuneError
	}
	switch {
	case r < 0x80:
		p[0] = byte(r)
		return 1
	case r < 0x800:
		_ = p[1]
		p[0] = byte(0xC0 | r>>6)
		p[1] = byte(0x80 | r&0x3F)
		return 2
	case r < 0x10000:
		_ = p[2]
		p[0] = byte(0xE0 | r>>12)
		p[1] = byte(0x80 | r>>6&0x3F)
		p[2] = byte(0x80 | r&0x3F)
		return 3
	}
	_ = p[3]
	p[0] = byte(0xF0 | r>>18)
	p[1] = byte(0x80 | r>>12&0x3F)
	p[2] = byte(0x80 | r>>6&0x3F)
	p[3] = byte(0x80 | r&0x3F)
	return 4
}

// AppendRune appends the UTF-8 encoding of r to p and returns the extended slice.
func AppendRune(p []byte, r rune) []byte {
	buf := [UTFMax]byte{}
	n := EncodeRune(buf[:], r)
	return append(p, buf[:n]...)
}

// RuneCountInString returns the number of runes in s, counting each invalid byte as one rune.
func RuneCountInString(s string) int {
	n := 0
	for range s {
		n++
	}
	return n
}

// RuneCount is RuneCountInString of the bytes of p.
func RuneCount(p []byte) int {
	n := 0
	for i := 0; i < len(p); {
		_, size := DecodeRune(p[i:])
		i += size
		n++
	}
	return n
}

// ValidString reports whether s consists only of valid UTF-8 encodings.
func ValidString(s string) bool {
	for i := 0; i < len(s); {
		r, size := DecodeRuneInString(s[i:])
		if r == RuneError && size == 1 {
			return false
		}
		i += size
	}
	return true
}

// Valid is ValidString of the bytes of p.
func Valid(p []byte) bool {
	for i := 0; i < len(p); {
		r, size := DecodeRune(p[i:])
		if r == RuneError && size == 1 {
			return false
		}
		i += size
	}
	return true
}

// ValidRune reports whether r can be encoded: every rune but a surrogate.
func ValidRune(r rune) bool {
	return r < 0xD800 || 0xDFFF < r
}

// RuneStart reports whether b can be the first byte of an encoding: it is not a continuation
// byte.
func RuneStart(b byte) bool {
	return b&0xC0 != 0x80
}
